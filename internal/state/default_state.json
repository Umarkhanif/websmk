  "classJournal": {
    "id": "jr-today-01",
    "scheduleId": "sch-aij-01",
    "subjectName": "Administrasi Infrastruktur Jaringan",
    "className": "XII TKJ 1",
    "teacherId": "usr-teacher-1",
    "teacherName": "Ir. Hendro Wijaya, S.T., M.Kom.",
    "teachDate": "2026-10-24",
    "syllabusTopic": "Konfigurasi BGP Multihoming & Routing Failover",
    "teacherNotes": "Siswa praktik menghubungkan 2 ISP simulasi di router MikroTik RB750Gr3. Evaluasi routing table dan backup gateway otomatis.",
    "voiceAudioUrl": "https://r2.wesmk.sch.id/voice/audio_hendro_20261024.mp3",
    "voiceTranscript": "Halo anak-anak XII TKJ 1, hari ini kita tuntaskan konfigurasi BGP Dual Multi-Home. Pastikan AS number tidak bentrok dan load balance recursive routing berjalan.",
    "leaderValidationStatus": "VALID_FULL",
    "validatedByStudentId": "std-budi-01",
    "validatedAt": "2026-10-24T10:15:00Z",
    "aiSmartNotes": {
      "summary": "BGP (Border Gateway Protocol) adalah protokol routing eksterior standar internet untuk menukar informasi routing antar Autonomous System (AS). Praktik hari ini fokus pada teknik Failover otomatis saat link ISP utama mati.",
      "workshopSteps": [
        "Pasang kabel console ke port router MikroTik RB750Gr3 dan jalankan Winbox.",
        "Tentukan AS Number private (misal 65001) pada menu /routing bgp instance.",
        "Tambahkan IP Peer ISP Utama dan ISP Backup di menu /routing bgp peer.",
        "Konfigurasi BGP weight atau local-preference agar traffic keluar mengutamakan ISP Utama.",
        "Uji cabut kabel ISP Utama dan catat waktu konvergensi failover ke ISP Backup (<3 detik)."
      ],
      "industryCase": "Data Center Tokopedia/Telkomsel menggunakan BGP multi-homing agar aplikasi tidak pernah down saat salah satu penyedia kabel fiber optik bawah laut putus."
    }
  },

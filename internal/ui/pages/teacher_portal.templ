package pages

import (
	"strconv"

	"wesmk/internal/ui"
	"wesmk/internal/ui/components"
)

templ TeacherPortal(data ui.TeacherPortalPage) {
	<div class="page-stack">
		if data.Tab == "dashboard" {
			<section class="identity-card">
				<div class="identity-main">
					<span class="avatar avatar-lg">{ data.Shell.Initials }</span>
					<div class="identity-copy">
						<span class="eyebrow">Portal Guru</span>
						<h2>Selamat Mengajar, { data.Shell.FullName }</h2>
						<p class="identity-meta mono">NIP { data.Shell.Username } · Wali Kelas XII TKJ 1</p>
					</div>
				</div>
				<form method="post" action="/teacher/alert-piket">
					<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
					<button type="submit" class="button button-danger">
						@components.Icon("radio", "icon")
						<span>Sinyal Izin ke Piket</span>
					</button>
				</form>
			</section>

			<div class="dashboard-grid">
				<article class="card stat-card">
					<span class="eyebrow">Lab TKJ 1 (Jam 1–4)</span>
					<p class="stat-title">XII TKJ 1 • Administrasi Jaringan</p>
					<p class="stat-note">Topik: { data.Journal.Topic }</p>
					<div class="stat-card-foot">
						<span>Validasi Kelas</span>
						<span class={ "badge " + statusBadgeClass(data.Journal.LeaderStatus) }>{ ui.StatusLabel(data.Journal.LeaderStatus) }</span>
					</div>
				</article>

				<article class="card stat-card">
					<span class="eyebrow">Bengkel Fiber (Jam 5–8)</span>
					<p class="stat-title">XI TKJ 2 • Troubleshooting WAN</p>
					<p class="stat-note">Praktik penyambungan serat optik &amp; redaman OPM.</p>
					<div class="stat-card-foot">
						<span>Status Ruang</span>
						<span class="badge badge-success">Siap Praktik</span>
					</div>
				</article>

				<article class="card stat-card">
					<span class="eyebrow">Bimbingan Siswa</span>
					<p class="stat-title">Siswa Wali &amp; PKL</p>
					<p class="stat-note">{ strconv.Itoa(len(data.PklJournals)) } jurnal PKL · { strconv.Itoa(len(data.ExamQuestions)) } soal master.</p>
					<div class="stat-card-foot">
						<a href="/teacher/classroom" class="text-link">Buka Agenda Kelas</a>
					</div>
				</article>
			</div>
		} else if data.Tab == "classroom" {
			<section class="card form-stack">
				<div class="stat-card-head">
					<div>
						<span class="eyebrow">Agenda Pembelajaran</span>
						<h2>Agenda Mengajar Kelas XII TKJ 1</h2>
					</div>
					@components.InfoBubble("Jurnal harian mengajar yang otomatis sinkron dengan catatan wali dan presensi siswa.")
				</div>
				<form method="post" action="/teacher/journal" class="form-stack">
					<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
					<div class="field">
						<div class="field-head">
							<label class="field-label">Topik &amp; Kompetensi Dasar</label>
						</div>
						<input class="input" type="text" name="topic" value={ data.Journal.Topic } required/>
					</div>
					<div class="field">
						<div class="field-head">
							<label class="field-label">Catatan Instruktur</label>
						</div>
						<textarea class="input" name="notes" required>{ data.TeacherNotes }</textarea>
					</div>
					<div class="field">
						<div class="field-head">
							<label class="field-label">Modul Praktik Bengkel</label>
							@components.InfoBubble("Instruksi alat dan prosedur keselamatan kerja K3 bengkel.")
						</div>
						<textarea class="input" name="ai_notes" required>{ data.AiSmartNotes }</textarea>
					</div>
					<button type="submit" class="button button-primary">Simpan Agenda</button>
				</form>
			</section>

			<section class="card form-stack">
				<span class="eyebrow">Presensi Kelas</span>
				<h3>Daftar Siswa Kelas XII TKJ 1</h3>
				<div class="table-wrap">
					<table class="data-table">
						<thead>
							<tr>
								<th>Nama Siswa</th>
								<th>NISN</th>
								<th>Jam Gerbang</th>
								<th>Sumber Verifikasi</th>
								<th>Status Kehadiran</th>
								<th>Tindakan Guru</th>
							</tr>
						</thead>
						<tbody>
							for _, a := range data.Attendances {
								<tr>
									<td><strong>{ a.StudentName }</strong></td>
									<td class="mono">{ a.NISN }</td>
									<td class="mono">{ a.GateTapTime }</td>
									<td>{ a.VerifiedSource }</td>
									<td><span class={ "badge " + attendanceBadgeClass(a.Status) }>{ a.StatusLabel }</span></td>
									<td>
										<form method="post" action="/teacher/attendance/toggle">
											<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
											<input type="hidden" name="attendance_id" value={ a.ID }/>
											if a.Status == "ALPA_BOLOS" {
												<button type="submit" class="button button-secondary button-small">Pulihkan Hadir</button>
											} else {
												<button type="submit" class="button button-danger button-small">Tandai Alpa / Bolos</button>
											}
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		} else if data.Tab == "question-bank" {
			<section class="card form-stack">
				<div class="stat-card-head">
					<div>
						<span class="eyebrow">Bank Soal</span>
						<h2>Bank Soal AIJ ({ strconv.Itoa(len(data.ExamQuestions)) } Soal Aktif)</h2>
					</div>
					@components.InfoBubble("Butir soal CBT dengan validasi kunci otomatis di server untuk pilihan ganda.")
				</div>
				<form method="post" action="/teacher/question/add" class="form-stack">
					<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
					<div class="form-row">
						<div class="field">
							<div class="field-head">
								<label class="field-label">Tipe Soal</label>
								@components.InfoBubble("Pilihan Ganda dinilai otomatis; Esai dinilai manual oleh guru pengampu.")
							</div>
							<select class="input" name="question_type">
								<option value="MULTIPLE_CHOICE">Pilihan Ganda (A/B/C/D)</option>
								<option value="ESSAY">Esai / Uraian</option>
							</select>
						</div>
						<div class="field">
							<div class="field-head">
								<label class="field-label">Kunci Jawaban PG</label>
								@components.InfoBubble("Kunci disimpan di server dan tidak bocor ke browser siswa.")
							</div>
							<select class="input" name="correct_key">
								<option value="A">Opsi A</option>
								<option value="B">Opsi B</option>
								<option value="C">Opsi C</option>
								<option value="D">Opsi D</option>
							</select>
						</div>
					</div>
					<div class="field">
						<div class="field-head">
							<label class="field-label">Pertanyaan / Kasus Praktik</label>
						</div>
						<textarea class="input" name="question_text" placeholder="Tuliskan skenario gangguan jaringan atau pertanyaan..." required></textarea>
					</div>
					<div class="form-row">
						<input class="input" type="text" name="opt_a" placeholder="Pilihan A"/>
						<input class="input" type="text" name="opt_b" placeholder="Pilihan B"/>
						<input class="input" type="text" name="opt_c" placeholder="Pilihan C"/>
						<input class="input" type="text" name="opt_d" placeholder="Pilihan D"/>
					</div>
					<div class="field">
						<div class="field-head">
							<label class="field-label">Rubrik Penilaian Esai</label>
							@components.InfoBubble("Pedoman kata kunci dan bobot jawaban esai untuk koreksi guru.")
						</div>
						<input class="input" type="text" name="essay_rubric" placeholder="Mis. Menjelaskan subnet mask /24 dengan benar (skor maks: 25)..."/>
					</div>
					<button type="submit" class="button button-primary">Tambah ke Bank Soal</button>
				</form>

				<div class="table-wrap">
					<table class="data-table">
						<thead>
							<tr>
								<th>No</th>
								<th>Tipe</th>
								<th>Pertanyaan</th>
								<th>Kunci / Rubrik</th>
								<th>Aksi</th>
							</tr>
						</thead>
						<tbody>
							for _, q := range data.ExamQuestions {
								<tr>
									<td class="mono">#{ strconv.Itoa(q.QuestionNumber) }</td>
									<td><span class="badge badge-neutral">{ q.QuestionType }</span></td>
									<td><strong>{ q.QuestionText }</strong></td>
									<td class="mono">
										if q.QuestionType == "ESSAY" {
											{ q.EssayRubric }
										} else {
											Kunci: { q.CorrectKey }
										}
									</td>
									<td>
										<form method="post" action="/teacher/question/delete">
											<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
											<input type="hidden" name="question_id" value={ q.ID }/>
											<button type="submit" class="button button-danger button-small">Hapus</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		} else if data.Tab == "exam-control" {
			<section class="card form-stack" x-data="{ selectedStudents: [], selectAll: false, reason: 'Kendala teknis lab komputer' }">
				<div class="stat-card-head">
					<div>
						<span class="eyebrow">Live Proctoring &amp; Kendali Anti-Curang</span>
						<h2>Pengawasan Ujian CBT (Live)</h2>
					</div>
					<div class="flex-actions" style="display:flex; gap:8px; flex-wrap:wrap;">
						<form method="post" action="/teacher/proctor/mass-unlock">
							<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
							<button type="submit" class="button button-secondary button-small">Buka Kunci Seluruh Lab</button>
						</form>
						<form method="post" action="/teacher/proctor/bulk-reset" onsubmit="return confirm('PERINGATAN: Anda akan me-reset ujian SELURUH siswa di ruangan lab ini. Semua status pengerjaan akan dimulai dari 0. Lanjutkan?');">
							<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
							<input type="hidden" name="reset_all" value="1"/>
							<input type="hidden" name="reason" value="Reset massal seluruh ruangan lab oleh pengawas"/>
							<button type="submit" class="button button-danger button-small">
								@components.Icon("rotate-ccw", "icon-xs")
								<span>Reset Seluruh Lab</span>
							</button>
						</form>
					</div>
				</div>

				<!-- Bulk Action Bar for Selected Students -->
				<form method="post" action="/teacher/proctor/bulk-reset" x-show="selectedStudents.length > 0" class="note-card" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; padding:12px 16px; border:1px solid #F59E0B; background:#FFFBEB; border-radius:10px;">
					<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
					<template x-for="sId in selectedStudents" :key="sId">
						<input type="hidden" name="student_ids" :value="sId"/>
					</template>
					<div style="display:flex; align-items:center; gap:10px;">
						<span class="badge badge-warning" x-text="selectedStudents.length + ' Peserta Dipilih'"></span>
						<span style="font-size:0.85rem; font-weight:600; color:#92400E;">Aksi Massal: Reset sesi ujian peserta terpilih</span>
					</div>
					<div style="display:flex; align-items:center; gap:8px;">
						<input class="input" style="min-height:36px; padding:4px 10px; font-size:0.82rem; width:220px;" name="reason" placeholder="Alasan reset ujian..." x-model="reason" required/>
						<button type="submit" class="button button-danger button-small" onclick="return confirm('Yakin ingin mereset ujian siswa yang dipilih? Jawaban mereka akan dikosongkan dan sesi dimulai dari awal.');">
							@components.Icon("rotate-ccw", "icon-xs")
							<span>Reset Terpilih</span>
						</button>
						<button type="button" class="button button-secondary button-small" @click="selectedStudents = []; selectAll = false">Batal</button>
					</div>
				</form>

				<div class="table-wrap">
					<table class="data-table">
						<thead>
							<tr>
								<th style="width:36px; text-align:center;">
									<input type="checkbox" x-model="selectAll" @change="selectedStudents = selectAll ? ['std-budi-01', 'std-budi-02', 'std-budi-03', 'std-budi-04'] : []" title="Pilih Semua"/>
								</th>
								<th>Nama Peserta</th>
								<th>NISN</th>
								<th>Progres</th>
								<th>Status Kiosk</th>
								<th>Catatan / Token</th>
								<th>Tindakan Pengawas</th>
							</tr>
						</thead>
						<tbody>
							for _, p := range data.ProctorStudents {
								<tr>
									<td style="text-align:center;">
										<input type="checkbox" value={ p.StudentID } x-model="selectedStudents"/>
									</td>
									<td><strong>{ p.Name }</strong></td>
									<td class="mono">{ p.NISN }</td>
									<td class="mono">{ p.Progress }</td>
									<td>
										if p.Status == "LOCKED" {
											<span class="badge badge-danger">TERKUNCI ({ strconv.Itoa(p.LockCount) }x)</span>
										} else if p.Status == "SUBMITTED" {
											<span class="badge badge-success">SELESAI</span>
										} else {
											<span class="badge badge-teal">{ p.Status }</span>
										}
									</td>
									<td>
										<span>{ p.LastViolation }</span>
										if p.UnlockToken != "" {
											<br/><span class="mono">Token: { p.UnlockToken }</span>
										}
									</td>
									<td>
										<div class="leader-actions" style="display:flex; gap:6px; flex-wrap:wrap; align-items:center;">
											<form method="post" action="/teacher/proctor/unlock" style="display:inline-flex; gap:4px;">
												<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
												<input type="hidden" name="student_id" value={ p.StudentID }/>
												<input class="input input-mono" style="min-height:36px; width:70px; padding:4px 8px; font-size:0.8rem;" name="unlock_token" placeholder="Token" required/>
												<button type="submit" class="button button-primary button-small" title="Buka Kunci Layar">Buka</button>
											</form>
											<form method="post" action="/teacher/proctor/emergency-ticket" style="display:inline-flex;">
												<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
												<input type="hidden" name="student_id" value={ p.StudentID }/>
												<button type="submit" class="button button-secondary button-small" title="Beri Tiket Darurat 2 Jam">Tiket 2 Jam</button>
											</form>
											<form method="post" action="/teacher/proctor/reset-exam" onsubmit="return confirm('Reset ujian untuk siswa ini? Sesi CBT akan diaktifkan kembali dan jawaban dikosongkan.');" style="display:inline-flex;">
												<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
												<input type="hidden" name="student_id" value={ p.StudentID }/>
												<input type="hidden" name="reason" value="Kendala teknis / izin pengawas"/>
												<button type="submit" class="button button-danger button-small" title="Reset Ujian Siswa (Hapus submission, izinkan mulai ulang)">
													@components.Icon("rotate-ccw", "icon-xs")
													<span>Reset</span>
												</button>
											</form>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>

			<!-- Audit Trail Table for Exam Resets -->
			<section class="card form-stack">
				<div class="stat-card-head">
					<div>
						<span class="eyebrow">Audit Trail Server</span>
						<h3>Riwayat Audit Reset Ujian Pengawas</h3>
					</div>
					<span class="badge badge-teal">{ strconv.Itoa(len(data.ExamResetLogs)) } Catatan Audit</span>
				</div>
				if len(data.ExamResetLogs) == 0 {
					<p class="muted">Belum ada riwayat reset ujian yang tercatat hari ini.</p>
				} else {
					<div class="table-wrap">
						<table class="data-table">
							<thead>
								<tr>
									<th>Waktu Audit</th>
									<th>Nama Peserta</th>
									<th>Pengawas Bertugas</th>
									<th>Alasan Reset</th>
									<th>Metode</th>
								</tr>
							</thead>
							<tbody>
								for _, r := range data.ExamResetLogs {
									<tr>
										<td class="mono">{ r.CreatedAt }</td>
										<td><strong>{ r.StudentName }</strong></td>
										<td>{ r.ProctorName }</td>
										<td>{ r.Reason }</td>
										<td>
											if r.IsBulk {
												<span class="badge badge-warning">Massal</span>
											} else {
												<span class="badge badge-neutral">Individu</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</section>

			<section class="card form-stack">
				<span class="eyebrow">Koreksi Esai</span>
				<h3>Koreksi Jawaban Esai Siswa ({ data.ActiveStudent.FullName })</h3>
				<form method="post" action="/teacher/essay/grade" class="form-row">
					<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
					<input type="hidden" name="student_id" value={ data.ActiveStudent.ID }/>
					<label class="field">
						<span class="field-label">Nilai Akhir CBT &amp; Esai (0–100)</span>
						<input class="input input-mono" type="number" name="score" value={ strconv.Itoa(data.CbtScore) } min="0" max="100" required/>
					</label>
					<div class="field">
						<span class="field-label">&nbsp;</span>
						<button type="submit" class="button button-primary">Sahkan Nilai ke Rapor</button>
					</div>
				</form>
			</section>
		} else if data.Tab == "homeroom-pkl" {
			<section class="card form-stack">
				<span class="eyebrow">Evaluasi Wali Kelas</span>
				<h2>Penilaian Sikap &amp; Konsensus Guru</h2>
				<p class="muted">Skor ekstrem tunggal tanpa catatan pelanggaran disesuaikan secara statistik agar penilaian objektif dan proporsional.</p>

				<form method="post" action="/teacher/homeroom/attitude" class="form-stack">
					<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
					<input type="hidden" name="student_id" value={ data.ActiveStudent.ID }/>
					<h4>Input Nilai Sikap 5 Guru Mapel untuk: { data.ActiveStudent.FullName } (Skor Saat Ini: { strconv.Itoa(data.ActiveStudent.AttitudeScore) })</h4>
					<div class="form-row">
						<label class="field">
							<span class="field-label">Guru Produktif TKJ</span>
							<input class="input input-mono" type="number" name="s1" value="94" min="0" max="100" required/>
						</label>
						<label class="field">
							<span class="field-label">Guru Matematika</span>
							<input class="input input-mono" type="number" name="s2" value="92" min="0" max="100" required/>
						</label>
						<label class="field">
							<span class="field-label">Guru Bahasa Inggris</span>
							<input class="input input-mono" type="number" name="s3" value="93" min="0" max="100" required/>
						</label>
						<label class="field">
							<span class="field-label">Guru Kewirausahaan</span>
							<input class="input input-mono" type="number" name="s4" value="95" min="0" max="100" required/>
						</label>
						<label class="field">
							<span class="field-label">Guru Mapel Lain (Uji Outlier)</span>
							<input class="input input-mono" type="number" name="s5" value="45" min="0" max="100" required/>
						</label>
					</div>
					<label class="field">
						<span class="field-label">Catatan Apresiasi Wali Kelas di Rapor &amp; Portal Orang Tua</span>
						<input class="input" type="text" name="homeroom_note" value={ data.ActiveStudent.HomeroomNote } required/>
					</label>
					<button type="submit" class="button button-primary">Hitung Filter Konsensus MAD &amp; Simpan ke Rapor</button>
				</form>
			</section>

			<section class="card form-stack">
				<div class="stat-card-head">
					<div>
						<span class="eyebrow">Pemantauan Guru Pembimbing PKL</span>
						<h3>Log Presensi Haversine GPS &amp; Bulk ACC Jurnal Mingguan Siswa</h3>
					</div>
					<form method="post" action="/teacher/pkl/bulk-approve">
						<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
						<button type="submit" class="button button-primary button-small">Bulk ACC Seluruh Jurnal PKL</button>
					</form>
				</div>

				<div class="table-wrap">
					<table class="data-table">
						<thead>
							<tr>
								<th>Tanggal</th>
								<th>Siswa</th>
								<th>Mitra DUDI</th>
								<th>Aktivitas &amp; Kompetensi</th>
								<th>Status DUDI</th>
								<th>Status Guru Pembimbing</th>
							</tr>
						</thead>
						<tbody>
							for _, j := range data.PklJournals {
								<tr>
									<td class="mono">{ j.Date }</td>
									<td><strong>{ j.StudentName }</strong></td>
									<td>{ j.CompanyName }</td>
									<td><strong>{ j.ActivityTitle }</strong><br/><span class="muted">{ j.CompetencyLearned }</span></td>
									<td>
										if j.SupervisorApproved {
											<span class="badge badge-success">Disetujui DUDI</span>
										} else {
											<span class="badge badge-warning">Menunggu DUDI</span>
										}
									</td>
									<td>
										if j.TeacherApproved {
											<span class="badge badge-success">Sudah di-ACC</span>
										} else {
											<span class="badge badge-neutral">Menunggu ACC</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		}
	</div>
}

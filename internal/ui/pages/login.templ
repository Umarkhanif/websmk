package pages

import (
	"wesmk/internal/ui"
	"wesmk/internal/ui/components"
)

templ Login(page ui.LoginPage) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<meta name="color-scheme" content="light"/>
			<meta name="theme-color" content="#C60C46"/>
			<title>Masuk — { ui.SchoolName() }</title>
			<meta name="description" content={ "Masuk ke portal layanan " + ui.SchoolName() + "." }/>
			<link rel="icon" type="image/svg+xml" href="/ui-assets/favicon.svg"/>
			<link rel="manifest" href="/ui-assets/manifest.webmanifest"/>
			<link rel="apple-touch-icon" href="/ui-assets/apple-touch-icon.png"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-title" content="WESMK"/>
			<link rel="preload" href="/ui-assets/fonts/poppins-400-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/ui-assets/fonts/poppins-700-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/ui-assets/fonts/pt-serif-400-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href="/ui-assets/app.css?v=20261128b"/>
			<script src="/ui-assets/app.js?v=20261128p" defer></script>
		</head>
		<body class="login-body">
			<main class="login-shell">
				<section class="login-visual" aria-label="Identitas sekolah">
					<div class="login-visual-inner">
						<div class="login-school-lockup">
							<strong>{ ui.SchoolName() }</strong>
							<span>Portal layanan sekolah</span>
						</div>

						<div class="login-visual-copy">
							<p class="login-kicker">Tahun ajaran { page.AcademicYear }</p>
							<h1>Satu pintu untuk belajar, berkarya, dan tumbuh.</h1>
							<p class="login-lead">
								Akademik, keuangan, PKL, dan komunikasi sekolah dalam satu tempat yang tenang dan jelas.
							</p>
						</div>

						<div class="login-visual-foot">
							<div class="login-major-list" aria-label="Kompetensi keahlian">
								<span>TKJ</span>
								<span>RPL</span>
								<span>TKR</span>
								<span>AKL</span>
							</div>
							<span class="login-visual-meta">Portal WESMK</span>
						</div>
					</div>

				</section>

				<section class="login-panel" aria-label="Form masuk">
					<div class="login-panel-inner">
						<a class="login-back" href="/">
							@components.Icon("arrow-right", "icon")
							<span>Beranda</span>
						</a>

						<div class="login-panel-head">
							<span class="eyebrow">Akun sekolah</span>
							<h2>Masuk ke akun Anda</h2>
							if page.Tab == "parent" {
								<p>Masuk dengan nomor WhatsApp orang tua atau wali yang terdaftar di sekolah.</p>
							} else {
								<p>Masuk dengan NISN siswa atau NIP guru dan staf sekolah.</p>
							}
						</div>

						<nav class="login-tabs" aria-label="Jenis akun">
							<a href="/login?tab=staff" class={ loginTabClass(page.Tab, "staff") } aria-current={ loginTabCurrent(page.Tab, "staff") }>
								Siswa &amp; Guru / Staf
							</a>
							<a href="/login?tab=parent" class={ loginTabClass(page.Tab, "parent") } aria-current={ loginTabCurrent(page.Tab, "parent") }>
								Orang Tua
							</a>
						</nav>

						if page.Error != "" {
							<div class="alert alert-danger" role="alert">
								@components.Icon("alert", "icon")
								<span>{ page.Error }</span>
							</div>
						}
						if page.Notice != "" {
							<div class="alert alert-success" role="status">
								@components.Icon("check", "icon")
								<span>{ page.Notice }</span>
							</div>
						}

						if page.Tab == "parent" {
							<form method="post" action="/login/magic" class="form-stack">
								<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
								<div class="field">
									<div class="field-head">
										<label class="field-label" for="parent-phone">Nomor WhatsApp Orang Tua / Wali</label>
										@components.InfoBubble("Tautan masuk sekali pakai dikirim melalui WhatsApp resmi dan berlaku selama 5 menit.")
									</div>
									<input id="parent-phone" class="input input-mono" type="tel" name="phone" value={ page.ParentWA } placeholder="081234567800" autocomplete="tel" required/>
								</div>
								<button class="button button-primary button-block" type="submit">
									<span>Kirim Tautan WhatsApp</span>
									@components.Icon("mail", "icon")
								</button>
							</form>
						} else {
							<form method="post" action="/login" class="form-stack">
								<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
								<div class="field">
									<div class="field-head">
										<label class="field-label" for="identifier">NISN Siswa atau NIP Staf</label>
										@components.InfoBubble("Gunakan NISN 10-digit untuk siswa atau NIP/NUPTK untuk guru dan staf sekolah.")
									</div>
									<input id="identifier" class="input input-mono" type="text" name="identifier" value={ page.Identifier } placeholder="Masukkan NISN atau NIP" autocomplete="username" required/>
								</div>
								<div class="field">
									<div class="field-head">
										<label class="field-label" for="password">Kata Sandi</label>
										@components.InfoBubble("Kata sandi akun sekolah Anda. Hubungi admin TU jika lupa kata sandi.")
									</div>
									<input id="password" class="input" type="password" name="password" placeholder="••••••••" autocomplete="current-password" required/>
								</div>
								<button class="button button-primary button-block" type="submit">
									<span>Masuk ke Portal</span>
									@components.Icon("arrow-right", "icon")
								</button>
							</form>
						}

						if page.Tab != "parent" {
							<p class="login-help">
								Lupa kata sandi? <a href="/contact">Hubungi Admin TU</a>.
							</p>
						}


						<div class="login-panel-footer">
							<a href="/verify" class="text-link">
								@components.Icon("external", "icon icon-xs")
								<span>Verifikasi Dokumen Resmi</span>
							</a>
							<a href="/contact" class="text-link">
								@components.Icon("help", "icon icon-xs")
								<span>Bantuan &amp; Laporan</span>
							</a>
						</div>
					</div>
				</section>
			</main>
		</body>
	</html>
}

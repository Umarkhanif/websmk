package pages

import (
	"strconv"

	"wesmk/internal/ui"
	"wesmk/internal/ui/components"
)

// Home: public shell bergaya sfschool.org. Login, peran, dan rute aplikasi
// tidak berubah. Semua tautan mengarah ke rute nyata atau anchor di halaman ini.
templ Home(page ui.HomePage) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<meta name="color-scheme" content="light"/>
			<meta name="theme-color" content="#C60C46"/>
			<title>{ ui.SchoolName() } — Portal Layanan Sekolah</title>
			<meta name="description" content={ "Portal layanan " + ui.SchoolName() + ": akademik, keuangan, PKL, dan komunikasi sekolah untuk siswa, guru, orang tua, dan staf." }/>
			<link rel="canonical" href={ page.SiteURL + "/" }/>
			<meta property="og:type" content="website"/>
			<meta property="og:site_name" content={ ui.SchoolName() }/>
			<meta property="og:title" content={ ui.SchoolName() + " — Portal Layanan Sekolah" }/>
			<meta property="og:description" content={ "Portal layanan " + ui.SchoolName() + ": akademik, keuangan, PKL, dan komunikasi sekolah untuk siswa, guru, orang tua, dan staf." }/>
			<meta property="og:url" content={ page.SiteURL + "/" }/>
			<meta property="og:image" content={ page.SiteURL + "/ui-assets/images/fiction-hero.jpg" }/>
			<meta property="og:locale" content="id_ID"/>
			<meta name="twitter:card" content="summary_large_image"/>
			@templ.Raw(`<script type="application/ld+json">` + page.JSONLD + `</script>`)
			<link rel="icon" type="image/svg+xml" href="/ui-assets/favicon.svg"/>
			<link rel="manifest" href="/ui-assets/manifest.webmanifest"/>
			<link rel="apple-touch-icon" href="/ui-assets/apple-touch-icon.png"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-title" content="WESMK"/>
			<link rel="preload" href="/ui-assets/fonts/poppins-400-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/ui-assets/fonts/poppins-700-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/ui-assets/fonts/pt-serif-400-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/ui-assets/images/fiction-hero.jpg" as="image"/>
			<link rel="stylesheet" href="/ui-assets/app.css?v=20261128b"/>
			<link rel="stylesheet" href="/ui-assets/landing.css?v=20261128o"/>
			<script src="/ui-assets/app.js?v=20261128p" defer></script>
		</head>
		<body class="sf-body">
			<a class="skip-link" href="#main-content">Lewati ke konten utama</a>

			<header id="header-area">
				<div class="sf-wrap sf-header-inner">
					<a class="sf-logo" href="/" aria-label={ ui.SchoolName() + " beranda" }>
						<img class="sf-logo-emblem" src="/ui-assets/images/logo-emblem.png" alt="" width="120" height="108"/>
						<span class="sf-logo-text"><strong>{ ui.SchoolName() }</strong><small>Portal Layanan Sekolah</small></span>
					</a>
						<nav class="sf-nav" aria-label="Navigasi utama">
							<details class="sf-drop"><summary>Tentang</summary><div class="sf-drop-panel">
								<a href="#tentang">Tentang sekolah</a><a href="#magic">Nilai &amp; pembelajaran</a><a href="#keamanan">Keamanan</a><a href="/contact">Kontak</a>
							</div></details>
							<details class="sf-drop"><summary>Akademik</summary><div class="sf-drop-panel">
								<a href="#program">Program keahlian</a><a href="#layanan">Layanan portal</a><a href="#mitra">Mitra industri</a>
							</div></details>
							<details class="sf-drop"><summary>Kehidupan siswa</summary><div class="sf-drop-panel">
								<a href="#siswa">Kampus &amp; praktik</a><a href="#mitra">PKL &amp; bursa kerja</a>
							</div></details>
							<details class="sf-drop"><summary>Pendaftaran</summary><div class="sf-drop-panel">
								<a href="#pendaftaran">Cara dapat akun</a><a href="#masuk">Pintu masuk peran</a><a href="#faq">FAQ</a>
							</div></details>
							<a href="#berita">Berita</a>
						</nav>

						<div class="sf-header-actions">
							<a class="sf-btn sf-btn-primary sf-btn-round" href="/login">Masuk ke portal</a>
							<details class="sf-menu">
								<summary class="sf-menu-btn" aria-label="Buka menu"><span class="sf-menu-bars" aria-hidden="true"></span></summary>
								<nav class="sf-menu-panel" aria-label="Navigasi selengkapnya">
									<a href="#tentang">Tentang</a><a href="#magic">Nilai &amp; pembelajaran</a><a href="#program">Program keahlian</a>
									<a href="#siswa">Kehidupan siswa</a><a href="#mitra">Mitra industri</a><a href="#layanan">Layanan portal</a>
									<a href="#masuk">Pintu masuk peran</a><a href="#pendaftaran">Cara dapat akun</a><a href="#keamanan">Keamanan</a>
									<a href="#berita">Berita</a><a href="#faq">Pertanyaan</a><a href="/verify">Verifikasi dokumen</a>
									<a href="/contact">Bantuan &amp; laporan</a><a class="sf-btn sf-btn-primary" href="/login">Masuk ke portal</a>
								</nav>
							</details>
						</div>
					</div>
			</header>

			<!-- Popup info (SFS-style): muncul 2 detik setelah load, cookie 7 hari. -->
			<div class="sf-popup" id="sf-popup" aria-hidden="true">
				<div class="sf-popup-backdrop"></div>
				<div class="sf-popup-dialog" role="dialog" aria-modal="true" aria-labelledby="sf-popup-title">
					<button class="sf-popup-close" type="button" aria-label="Tutup popup">×</button>
					<img src="/ui-assets/images/fiction-campus.jpg" alt="Suasana kampus sekolah" width="1100" height="730" loading="lazy" decoding="async"/>
					<div class="sf-popup-body">
						<h2 id="sf-popup-title">Kenali { ui.SchoolName() } lebih dekat</h2>
						<p>Lihat program keahlian, ruang praktik, dan cara mendapatkan akun portal sekolah.</p>
						<a class="sf-btn sf-btn-primary sf-btn-round" href="#program">Lihat program keahlian</a>
					</div>
				</div>
			</div>

			<main id="main-content">
				<h1 class="sf-sr-only">{ ui.SchoolName() }</h1>
				<!-- Slider bergaya SFS: banner lebar, teks kanan, fade. -->
				<section class="sf-hero" aria-label="Sorotan">
					<div class="sf-hero-track" aria-hidden="true">
						<div class="sf-slide" style="background-image:url('/ui-assets/images/fiction-hero.jpg')"></div>
						<div class="sf-slide" style="background-image:url('/ui-assets/images/fiction-lab.jpg')"></div>
						<div class="sf-slide" style="background-image:url('/ui-assets/images/fiction-workshop.jpg')"></div>
						<div class="sf-slide" style="background-image:url('/ui-assets/images/fiction-campus.jpg')"></div>
					</div>
					<div class="sf-hero-overlay"></div>
					<button class="sf-hero-toggle" type="button" aria-pressed="false">Jeda sorotan</button>
					<div class="sf-wrap sf-hero-inner">
						<div class="sf-hero-captions" aria-hidden="true">
							<h2 class="sf-caption"><span>Tumbuhkan</span><span>Potensi.</span><span>Bersama.</span></h2>
							<h2 class="sf-caption"><span>Belajar</span><span>Dengan</span><span>Gembira.</span></h2>
							<h2 class="sf-caption"><span>Praktik</span><span>Nyata.</span><span>Siap Karya.</span></h2>
							<h2 class="sf-caption"><span>Sekolah</span><span>Kejuruan.</span><span>Berkembang.</span></h2>
						</div>
					</div>
				</section>

				<!-- Intro / misi: max 840px, tengah, bagian italic. -->
				<section class="sf-intro" id="tentang">
					<div class="sf-wrap">
						<div class="sf-narrow">
							<p>{ ui.SchoolName() } adalah sekolah menengah kejuruan yang menyiapkan siswa untuk kerja, kuliah, dan berwirausaha. Pembelajaran praktik di laboratorium dan bengkel dipadukan dengan kurikulum yang mengikuti kebutuhan dunia usaha dan industri.</p>
							<p class="sf-intro-em"><em>{ ui.SchoolName() } menumbuhkan dan merayakan potensi setiap siswa dalam komunitas yang saling menghormati, menghargai keberagaman, dan mencintai pembelajaran.</em></p>
						</div>
					</div>
				</section>

				<div class="sf-divider sf-divider-yellow" aria-hidden="true"></div>

				<section class="sf-section sf-section-alt" id="magic">
					<div class="sf-wrap">
						<div class="sf-head-center">
							<h2>Keistimewaan { ui.SchoolName() }</h2>
							<p>Di { ui.SchoolName() }, pembelajaran yang menyenangkan tumbuh karena setiap siswa dilihat dan didukung oleh komunitas yang beragam dan dekat. Lewat praktik, seni, dan proyek nyata, kami menumbuhkan kebaikan, kreativitas, kolaborasi, dan keunggulan.</p>
						</div>
						<div class="sf-cards">
							<article class="sf-card sf-color-primary">
								<div class="sf-card-media"><img src="/ui-assets/images/fiction-lab.jpg" alt="Siswa belajar di kelas" width="1800" height="1200" loading="lazy" decoding="async"/></div>
								<div class="sf-card-base"><h3>Karakter &amp; kepedulian</h3></div>
								<div class="sf-card-hover"><h3>Karakter &amp; kepedulian</h3><p>Dari kurikulum karakter sampai nilai inti, kami membentuk warga yang baik dan berani.</p><a class="sf-btn sf-btn-white sf-btn-sm" href="#tentang">Pelajari</a></div>
							</article>
							<article class="sf-card sf-color-secondary">
								<div class="sf-card-media"><img src="/ui-assets/images/fiction-community.jpg" alt="Siswa bekerja di laboratorium" width="1000" height="667" loading="lazy" decoding="async"/></div>
								<div class="sf-card-base"><h3>Belajar lewat praktik</h3></div>
								<div class="sf-card-hover"><h3>Belajar lewat praktik</h3><p>Siswa berpikir mendalam dan menjadi pembelajar seumur hidup lewat proyek kolaboratif.</p><a class="sf-btn sf-btn-white sf-btn-sm" href="#program">Pelajari</a></div>
							</article>
							<article class="sf-card sf-color-third">
								<div class="sf-card-media"><img src="/ui-assets/images/fiction-workshop.jpg" alt="Siswa praktik di bengkel" width="1392" height="752" loading="lazy" decoding="async"/></div>
								<div class="sf-card-base"><h3>Kampus praktik</h3></div>
								<div class="sf-card-hover"><h3>Kampus praktik</h3><p>Laboratorium dan bengkel dipakai setiap hari, jadi belajar dekat dengan dunia kerja.</p><a class="sf-btn sf-btn-white sf-btn-sm" href="#siswa">Pelajari</a></div>
							</article>
							<article class="sf-card sf-color-fourth">
								<div class="sf-card-media"><img src="/ui-assets/images/fiction-campus.jpg" alt="Upacara di halaman sekolah" width="1100" height="730" loading="lazy" decoding="async"/></div>
								<div class="sf-card-base"><h3>Rasa memiliki</h3></div>
								<div class="sf-card-hover"><h3>Rasa memiliki</h3><p>Komunitas yang hangat dan beragam memberi ruang bagi setiap siswa untuk tumbuh.</p><a class="sf-btn sf-btn-white sf-btn-sm" href="#mitra">Pelajari</a></div>
							</article>
						</div>
					</div>
				</section>

				if len(page.Stats) > 0 || page.AcademicYear != "" {
					<section class="sf-stats" aria-label="Sekolah dalam angka">
						<div class="sf-wrap sf-stats-grid">
							<div class="sf-stat sf-stat-year"><strong>{ page.AcademicYear }</strong><span>Tahun ajaran</span></div>
							for _, stat := range page.Stats {
								<div class="sf-stat"><strong>{ stat.Value }</strong><span>{ stat.Label }</span></div>
							}
						</div>
					</section>
				}

				<div class="sf-divider sf-divider-pink" aria-hidden="true"></div>

				<section class="sf-section" id="program">
					<div class="sf-wrap">
						<div class="sf-head-center"><h2>Program keahlian</h2><p>Baik siswa bergabung di TKJ, RPL, TKR, atau AKL, mereka disambut dalam program keahlian yang membangkitkan semangat belajar.</p></div>
						if len(page.Majors) > 0 {
							<div class="sf-cards sf-cards-3">
								for _, major := range page.Majors {
									<article class="sf-card sf-color-primary">
										<div class="sf-card-media sf-card-photo"></div>
										<div class="sf-card-base"><h3>{ major.Name }</h3></div>
										<div class="sf-card-hover">
											<h3>{ major.Name }</h3>
											<p class="sf-code">{ major.Code }</p>
											if major.Detail != "" {
												<p>{ major.Detail }</p>
											}
											if major.Head != "" {
												<p class="sf-muted">Ka. program: { major.Head }</p>
											}
											if major.Classes > 0 {
												<p class="sf-muted">{ strconv.Itoa(major.Classes) } rombel</p>
											}
											if major.Students > 0 {
												<p class="sf-muted">{ strconv.Itoa(major.Students) } siswa</p>
											}
											<a class="sf-btn sf-btn-white sf-btn-sm" href="#layanan">Lihat layanan</a>
										</div>
									</article>
								}
							</div>
						}
					</div>
				</section>

				<section class="sf-quote">
					<div class="sf-wrap sf-narrow">
						<blockquote>“Bersekolah di sini adalah salah satu keputusan terbaik untuk anak kami. Dia tumbuh percaya diri, dan kami pun ikut berkembang.”</blockquote>
						<p>— Orang tua siswa { ui.SchoolName() }</p>
					</div>
				</section>

				<div class="sf-divider sf-divider-teal" aria-hidden="true"></div>

				<section class="sf-section" id="siswa">
					<div class="sf-wrap sf-grid-2">
						<figure class="sf-figure"><img src="/ui-assets/images/fiction-workshop.jpg" alt="Guru mendampingi siswa di bengkel" width="1392" height="752" loading="lazy" decoding="async"/></figure>
						<div class="sf-prose">
							<h2>Ruang praktik yang dipakai setiap hari</h2>
							<p>Setiap program keahlian punya laboratorium atau bengkel sendiri, jadi jam produktif benar-benar dipakai untuk bekerja.</p>
							<a class="sf-btn sf-btn-primary sf-btn-round" href="#program">Lihat program keahlian</a>
						</div>
					</div>
				</section>

				<section class="sf-section sf-section-alt" id="berita">
					<div class="sf-wrap">
						<div class="sf-head-center"><h2>Berita &amp; kegiatan</h2></div>
						<div class="sf-posts">
							<a class="sf-post" href="#mitra">
								<img src="/ui-assets/images/fiction-workshop.jpg" alt="Siswa praktik mesin di bengkel" width="1392" height="752" loading="lazy" decoding="async"/>
								<div class="sf-post-body"><p class="sf-post-date">21 September 2026</p><h3>Siswa mengikuti pelatihan jaringan bersama mitra industri</h3><p>Siswa belajar langsung di laboratorium dan bengkel mitra sebagai bagian dari PKL.</p><span class="sf-btn sf-btn-outline sf-btn-round sf-btn-sm">Lihat mitra industri</span></div>
							</a>
							<a class="sf-post" href="#siswa">
								<img src="/ui-assets/images/fiction-campus.jpg" alt="Upacara bendera" width="1100" height="730" loading="lazy" decoding="async"/>
								<div class="sf-post-body"><p class="sf-post-date">29 Agustus 2026</p><h3>Upacara dan kegiatan komunitas sekolah</h3><p>Warga sekolah berkumpul untuk kegiatan bersama yang menumbuhkan rasa memiliki.</p><span class="sf-btn sf-btn-outline sf-btn-round sf-btn-sm">Lihat kehidupan siswa</span></div>
							</a>
							<a class="sf-post" href="#program">
								<img src="/ui-assets/images/fiction-lab.jpg" alt="Siswa mengerjakan tugas di kelas" width="1800" height="1200" loading="lazy" decoding="async"/>
								<div class="sf-post-body"><p class="sf-post-date">27 Maret 2026</p><h3>Proyek kolaboratif siswa dalam pelajaran</h3><p>Belajar lewat proyek membantu siswa berpikir kritis dan bekerja tim.</p><span class="sf-btn sf-btn-outline sf-btn-round sf-btn-sm">Lihat program keahlian</span></div>
							</a>
						</div>
					</div>
				</section>

				<section class="sf-section" id="layanan">
					<div class="sf-wrap">
						<div class="sf-head-center"><h2>Satu portal untuk keperluan sekolah sehari-hari</h2><p>Fitur yang dipakai sekolah setiap hari, dari presensi sampai penyaluran kerja. Akun dibuat oleh sekolah.</p></div>
						<ul class="sf-services">
							<li><strong>Presensi &amp; jurnal</strong><p>Kehadiran harian dan jurnal mengajar guru tercatat rapi.</p></li>
							<li><strong>Kuis, tugas, dan nilai</strong><p>Tugas, kuis, dan penilaian siswa dalam satu alur.</p></li>
							<li><strong>Ujian CBT</strong><p>Ujian berbasis komputer dengan sesi dan pemantauan.</p></li>
							<li><strong>Keuangan &amp; SPP</strong><p>Tagihan, pembayaran, dan kwitansi yang bisa diverifikasi.</p></li>
							<li><strong>PKL &amp; bursa kerja</strong><p>Penempatan PKL, jurnal harian, dan penyaluran kerja (BKK).</p></li>
							<li><strong>Administrasi akademik</strong><p>Data kelas, jadwal, dan wali kelas yang selalu terbaru.</p></li>
						</ul>
					</div>
				</section>

				if len(page.Partners) > 0 {
					<section class="sf-section sf-section-alt" id="mitra">
						<div class="sf-wrap">
							<div class="sf-head-center"><h2>Tempat siswa belajar bekerja</h2><p>Perusahaan yang sudah menerima siswa PKL. Nama pembimbing dan nomor kontak tetap di dalam portal.</p></div>
							<ul class="sf-partners">
								for _, partner := range page.Partners {
									<li>
										<strong>{ partner.Name }</strong>
										if partner.Sector != "" {
											<span>{ partner.Sector }</span>
										}
									</li>
								}
							</ul>
							if page.Headmaster != "" {
								<div class="sf-lead"><span class="sf-lead-avatar" aria-hidden="true">{ ui.Initials(page.Headmaster) }</span><div><p class="sf-eyebrow">Kepala sekolah</p><p class="sf-lead-name">{ page.Headmaster }</p><p>Menandatangani dokumen resmi secara elektronik dan memantau mutu akademik lewat portal yang sama.</p></div></div>
							}
						</div>
					</section>
				}

				<section class="sf-section" id="keamanan">
					<div class="sf-wrap">
						<div class="sf-head-center"><h2>Akun aman, data tetap terbatas</h2><p>Portal menyimpan data pribadi siswa, jadi aksesnya dijaga berlapis dan setiap dokumen bisa dilacak.</p></div>
						<ul class="sf-trust">
							<li><span class="sf-trust-icon">@components.Icon("lock", "icon")</span><span><strong>Verifikasi dua langkah</strong><span>Akun staf butuh lapisan kedua saat masuk.</span></span></li>
							<li><span class="sf-trust-icon">@components.Icon("eye", "icon")</span><span><strong>Akses per peran</strong><span>Siswa, guru, dan orang tua hanya menerima datanya sendiri.</span></span></li>
							<li><span class="sf-trust-icon">@components.Icon("file-check", "icon")</span><span><strong>Tanda tangan elektronik</strong><span>Surat dan kwitansi resmi ditandatangani secara elektronik.</span></span></li>
							<li><span class="sf-trust-icon">@components.Icon("shield-alert", "icon")</span><span><strong>Verifikasi publik</strong><span>Nomor dokumen bisa dicek siapa saja lewat halaman verifikasi.</span></span></li>
						</ul>
					</div>
				</section>

				<section class="sf-section sf-section-alt" id="masuk">
					<div class="sf-wrap sf-grid-2">
						<div class="sf-prose"><h2>Masuk sesuai peran Anda</h2><p>Setiap peran punya ruang kerjanya sendiri. Tidak ada data orang lain yang ikut terkirim ke layar Anda.</p><p><a href="/verify">Verifikasi dokumen</a> · <a href="/contact">Bantuan &amp; laporan</a></p></div>
						<div class="sf-gates">
							<a class="sf-gate" href="/login?tab=staff"><strong>Siswa, guru &amp; staf</strong><span>Masuk dengan NISN atau NIP</span><span class="sf-muted">Presensi · jadwal · tugas · CBT · nilai</span></a>
							<a class="sf-gate" href="/login?tab=parent"><strong>Orang tua &amp; wali</strong><span>Masuk dengan nomor WhatsApp terdaftar</span><span class="sf-muted">Perkembangan anak · SPP · izin · komunikasi</span></a>
						</div>
					</div>
				</section>

				<section class="sf-section" id="pendaftaran">
					<div class="sf-wrap">
						<div class="sf-head-center"><h2>Tidak ada pendaftaran mandiri</h2><p>Akun dibuat oleh sekolah supaya hanya orang yang benar-benar terdaftar yang bisa masuk.</p></div>
						<ol class="sf-steps">
							<li><span>01</span><h3>Sekolah mendaftarkan Anda</h3><p>Admin TU membuat akun dari data induk.</p></li>
							<li><span>02</span><h3>Terima identitas masuk</h3><p>NISN/NIP untuk siswa dan guru, WhatsApp terdaftar untuk orang tua.</p></li>
							<li><span>03</span><h3>Masuk dan amankan akun</h3><p>Ganti kata sandi awal, aktifkan verifikasi dua langkah untuk staf.</p></li>
						</ol>
					</div>
				</section>

				<section class="sf-section sf-section-alt" id="faq">
					<div class="sf-wrap sf-narrow">
						<div class="sf-head-center"><h2>Pertanyaan yang sering diajukan</h2></div>
						<div class="sf-faq">
							<details><summary>Bagaimana cara mendapatkan akun?</summary><p>Akun dibuat oleh sekolah. Hubungi Admin TU atau wali kelas untuk didaftarkan.</p></details>
							<details><summary>Saya lupa kata sandi.</summary><p>Buka halaman <a href="/contact">Bantuan &amp; laporan</a> dan sebutkan peran serta identitas Anda.</p></details>
							<details><summary>NISN atau NIP saya tidak dikenali.</summary><p>Pastikan nomor yang dipakai sama dengan data induk sekolah. Laporkan lewat halaman bantuan.</p></details>
							<details><summary>Orang tua tidak punya WhatsApp?</summary><p>Minta sekolah mengganti nomor wali yang terdaftar.</p></details>
							<details><summary>Bagaimana memastikan dokumen itu asli?</summary><p>Buka <a href="/verify">Verifikasi dokumen</a> dan masukkan nomor dokumen yang tertera.</p></details>
						</div>
					</div>
				</section>

				<section class="sf-reach">
					<div class="sf-wrap sf-grid-2">
						<div class="sf-prose"><h2>Ada pertanyaan?</h2><p>Lupa kata sandi, kendala akun, atau data yang perlu diperbaiki — sampaikan lewat halaman bantuan.</p><a class="sf-btn sf-btn-primary sf-btn-round" href="/contact">Hubungi sekolah</a></div>
						<figure class="sf-figure"><img src="/ui-assets/images/fiction-campus.jpg" alt="Upacara bendera di halaman sekolah" width="1100" height="730" loading="lazy" decoding="async"/></figure>
					</div>
				</section>
			</main>

			<footer class="sf-footer">
				<div class="sf-wrap sf-footer-main">
					<div class="sf-footer-left">
						<a class="sf-logo" href="/"><span class="sf-logo-mark" aria-hidden="true">{ ui.Initials(ui.SchoolName()) }</span><span class="sf-logo-text"><strong>{ ui.SchoolName() }</strong><small>Portal Layanan Sekolah</small></span></a>
						<div class="sf-social" aria-label="Tautan sekolah"><a href="/contact">Kontak</a><a href="/verify">Verifikasi</a><a href="/login">Portal</a></div>
					</div>
					<div class="sf-footer-cols">
						<div><h4>Tentang</h4><a href="#tentang">Tentang sekolah</a><a href="#magic">Nilai &amp; pembelajaran</a><a href="#program">Program keahlian</a><a href="/contact">Kontak</a></div>
						<div><h4>Terlibat</h4><a href="#pendaftaran">Cara dapat akun</a><a href="#masuk">Pintu masuk peran</a><a href="/verify">Verifikasi dokumen</a><a href="/contact">Bantuan</a></div>
						<div><h4>Bantuan</h4><a href="/contact">Hubungi sekolah</a><a href="#berita">Berita</a><a href="#faq">Pertanyaan</a><a href="/login">Masuk portal</a></div>
					</div>
				</div>
				<div class="sf-wrap sf-footer-note"><h4>Kebijakan sekolah</h4><p>{ ui.SchoolName() } menerima siswa tanpa memandang suku, agama, jenis kelamin, atau keadaan apapun dalam seluruh program dan kegiatan sekolah.</p></div>
				<div class="sf-wrap sf-footer-bottom"><span>© { ui.SchoolName() } · Portal WESMK</span><span>Tahun ajaran { page.AcademicYear }</span></div>
			</footer>
		</body>
	</html>
}

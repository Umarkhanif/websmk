package pages

import (
	"strconv"

	"wesmk/internal/ui"
	"wesmk/internal/ui/components"
)

// Home is the public front door of the school. It answers "sekolah apa ini dan
// apa yang bisa saya lakukan di sini" before asking anyone to log in.
templ Home(page ui.HomePage) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<meta name="color-scheme" content="light"/>
			<meta name="theme-color" content="#172E26"/>
			<title>SMK Negeri 1 Rekayasa — Portal Layanan Sekolah</title>
			<meta name="description" content="Portal layanan SMK Negeri 1 Rekayasa: akademik, keuangan, PKL, dan komunikasi sekolah untuk siswa, guru, orang tua, dan staf."/>
			<link rel="icon" type="image/svg+xml" href="/ui-assets/favicon.svg"/>
			<link rel="manifest" href="/ui-assets/manifest.webmanifest"/>
			<link rel="apple-touch-icon" href="/ui-assets/apple-touch-icon.png"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-title" content="WESMK"/>
			<link rel="preload" href="/ui-assets/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/ui-assets/images/home-hero.jpg" as="image"/>
			<link rel="stylesheet" href="/ui-assets/app.css?v=20261127a"/>
			<script src="/ui-assets/app.js?v=20261126a" defer></script>
		</head>
		<body class="home-body">
			<a class="skip-link" href="#main-content">Lewati ke konten utama</a>

			<header class="home-topbar">
				<div class="home-wrap home-topbar-inner">
					<a class="home-lockup" href="/">
						<span class="home-mark" aria-hidden="true">SMK</span>
						<span class="home-lockup-copy">
							<strong>SMK Negeri 1 Rekayasa</strong>
							<span>Portal layanan sekolah</span>
						</span>
					</a>
					<nav class="home-nav" aria-label="Navigasi utama">
						<a href="#layanan">Layanan</a>
						<a href="#jurusan">Program keahlian</a>
						<a href="#mitra">Mitra industri</a>
						<a href="#faq">Pertanyaan</a>
						<a href="/verify">Verifikasi dokumen</a>
					</nav>
					<a class="button button-primary home-login" href="/login">Masuk Portal</a>
					<details class="home-menu">
						<summary class="home-menu-btn">
							<span class="home-menu-bars" aria-hidden="true"></span>
							<span class="sr-only">Buka menu</span>
						</summary>
						<nav class="home-menu-panel" aria-label="Navigasi seluler">
							<a class="home-menu-cta" href="/login">Masuk ke Portal</a>
							<a href="#layanan">Layanan</a>
							<a href="#jurusan">Program keahlian</a>
							<a href="#mitra">Mitra industri</a>
							<a href="#akun">Cara dapat akun</a>
							<a href="#faq">Pertanyaan</a>
							<a href="/verify">Verifikasi dokumen</a>
							<a href="/contact">Bantuan</a>
						</nav>
					</details>
				</div>
			</header>

			<main id="main-content">
				<section class="home-hero">
					<div class="home-hero-bg">
						<img
							src="/ui-assets/images/home-hero.jpg"
							alt="Siswa SMK berpraktik di laboratorium jaringan komputer bersama guru"
							width="1392"
							height="752"
							fetchpriority="high"
							decoding="async"
						/>
					</div>
					<div class="home-wrap home-hero-inner">
						<div class="home-hero-copy">
							<p class="home-kicker">Tahun ajaran { page.AcademicYear }</p>
							<h1>Sekolah kejuruan untuk kerja, kuliah, dan berwirausaha.</h1>
							<p class="home-lead">
								Akademik, keuangan, PKL, dan komunikasi sekolah dalam satu portal.
								Satu akun untuk siswa, guru, orang tua, dan staf sekolah.
							</p>
							<div class="home-actions">
								<a class="button button-gold" href="/login">
									@components.Icon("arrow-right", "icon")
									<span>Masuk ke Portal</span>
								</a>
								<a class="button home-hero-outline" href="#jurusan">
									@components.Icon("compass", "icon")
									<span>Lihat program keahlian</span>
								</a>
							</div>
						</div>

						<aside class="home-quick" aria-label="Akses cepat">
							<p class="home-quick-title">Akses cepat</p>
							<a class="home-quick-row" href="/login?tab=staff">
								<span class="home-quick-icon">@components.Icon("users", "icon")</span>
								<span>
									<strong>Siswa, guru &amp; staf</strong>
									<span>NISN atau NIP</span>
								</span>
								<span class="home-quick-go" aria-hidden="true">→</span>
							</a>
							<a class="home-quick-row" href="/login?tab=parent">
								<span class="home-quick-icon">@components.Icon("heart", "icon")</span>
								<span>
									<strong>Orang tua &amp; wali</strong>
									<span>Nomor WhatsApp terdaftar</span>
								</span>
								<span class="home-quick-go" aria-hidden="true">→</span>
							</a>
							<a class="home-quick-row" href="/verify">
								<span class="home-quick-icon">@components.Icon("file-check", "icon")</span>
								<span>
									<strong>Verifikasi dokumen</strong>
									<span>Kwitansi, surat, jurnal PKL</span>
								</span>
								<span class="home-quick-go" aria-hidden="true">→</span>
							</a>
						</aside>
					</div>
				</section>

				<div class="home-facts">
					<div class="home-wrap">
						<dl class="home-facts-grid">
							<div class="home-fact">
								<dt>Tahun ajaran</dt>
								<dd class="home-fact-text">{ page.AcademicYear }</dd>
							</div>
							for _, stat := range page.Stats {
								<div class="home-fact">
									<dt>{ stat.Label }</dt>
									<dd class="mono">{ stat.Value }</dd>
								</div>
							}
						</dl>
					</div>
				</div>

				<section class="home-section" id="layanan">
					<div class="home-wrap">
						<header class="home-section-head">
							<p class="eyebrow">Pintu masuk</p>
							<h2>Masuk sesuai peran Anda</h2>
							<p>
								Setiap peran punya ruang kerjanya sendiri. Tidak ada data orang lain
								yang ikut terkirim ke layar Anda.
							</p>
						</header>

						<div class="home-doors">
							<a class="home-door" href="/login?tab=staff">
								<span class="home-door-icon">@components.Icon("users", "icon")</span>
								<span class="home-door-eyebrow">Portal sekolah</span>
								<strong>Siswa, guru &amp; staf</strong>
								<p>
									Presensi, jadwal, tugas, ujian CBT, jurnal mengajar, dan nilai
									dalam satu akun.
								</p>
								<span class="home-door-go">Masuk dengan NISN atau NIP <span aria-hidden="true">→</span></span>
							</a>
							<a class="home-door" href="/login?tab=parent">
								<span class="home-door-icon">@components.Icon("heart", "icon")</span>
								<span class="home-door-eyebrow">Portal keluarga</span>
								<strong>Orang tua &amp; wali</strong>
								<p>
									Pantau perkembangan anak, tagihan SPP, izin tidak masuk, dan
									komunikasi dengan sekolah.
								</p>
								<span class="home-door-go">Masuk dengan WhatsApp <span aria-hidden="true">→</span></span>
							</a>
						</div>

						<div class="home-utils">
							<a class="home-util" href="/verify">
								<span class="home-util-icon">@components.Icon("shield-alert", "icon")</span>
								<span>
									<strong>Verifikasi dokumen</strong>
									<span>Cek keaslian kwitansi, surat resmi, dan jurnal PKL.</span>
								</span>
							</a>
							<a class="home-util" href="/contact">
								<span class="home-util-icon">@components.Icon("help", "icon")</span>
								<span>
									<strong>Bantuan &amp; laporan</strong>
									<span>Lupa kata sandi, kendala akun, atau gangguan aplikasi.</span>
								</span>
							</a>
						</div>
					</div>
				</section>

				<section class="home-section home-section-alt">
					<div class="home-wrap">
						<header class="home-section-head">
							<p class="eyebrow">Layanan</p>
							<h2>Yang bisa dilakukan di portal</h2>
							<p>Fitur yang dipakai sekolah setiap hari, dari presensi sampai penyaluran kerja.</p>
						</header>

						<div class="home-features">
							<article class="home-feature">
								<span class="home-feature-icon">@components.Icon("calendar", "icon")</span>
								<h3>Presensi &amp; jurnal</h3>
								<p>Kehadiran harian dan jurnal mengajar guru tercatat rapi.</p>
							</article>
							<article class="home-feature">
								<span class="home-feature-icon">@components.Icon("file-check", "icon")</span>
								<h3>Kuis, tugas, dan nilai</h3>
								<p>Tugas, kuis, dan penilaian siswa dalam satu alur.</p>
							</article>
							<article class="home-feature">
								<span class="home-feature-icon">@components.Icon("monitor", "icon")</span>
								<h3>Ujian CBT</h3>
								<p>Ujian berbasis komputer dengan sesi dan pemantauan.</p>
							</article>
							<article class="home-feature">
								<span class="home-feature-icon">@components.Icon("wallet", "icon")</span>
								<h3>Keuangan &amp; SPP</h3>
								<p>Tagihan, pembayaran, dan kwitansi yang bisa diverifikasi.</p>
							</article>
							<article class="home-feature">
								<span class="home-feature-icon">@components.Icon("briefcase", "icon")</span>
								<h3>PKL &amp; bursa kerja</h3>
								<p>Penempatan PKL, jurnal harian, dan penyaluran kerja (BKK).</p>
							</article>
							<article class="home-feature">
								<span class="home-feature-icon">@components.Icon("graduation", "icon")</span>
								<h3>Administrasi akademik</h3>
								<p>Data kelas, jadwal, dan wali kelas yang selalu terbarui.</p>
							</article>
						</div>
					</div>
				</section>

				if len(page.Majors) > 0 {
					<section class="home-section" id="jurusan">
						<div class="home-wrap">
							<header class="home-section-head">
								<p class="eyebrow">Program keahlian</p>
								<h2>Belajar lewat praktik, bukan hanya teori</h2>
								<p>Jalur kejuruan dengan mitra industri untuk PKL dan penyaluran kerja.</p>
							</header>

							<div class="home-majors">
								for _, major := range page.Majors {
									<article class="home-major">
										<header class="home-major-top">
											<span class="home-major-code mono">{ major.Code }</span>
											if major.Classes > 0 {
												<span class="home-major-flag mono">{ strconv.Itoa(major.Classes) } rombel</span>
											}
										</header>
										<h3>{ major.Name }</h3>
										if major.Detail != "" {
											<p class="home-major-lab">
												@components.Icon("monitor", "icon-xs")
												<span>{ major.Detail }</span>
											</p>
										}
										if major.Head != "" {
											<p class="home-major-head">Ka. program: { major.Head }</p>
										}
										if major.Students > 0 || major.Partners > 0 {
											<dl class="home-major-meta mono">
												if major.Students > 0 {
													<div>
														<dt>Siswa</dt>
														<dd>{ strconv.Itoa(major.Students) }</dd>
													</div>
												}
												if major.Partners > 0 {
													<div>
														<dt>Mitra DUDI</dt>
														<dd>{ strconv.Itoa(major.Partners) }</dd>
													</div>
												}
											</dl>
										}
									</article>
								}
							</div>
						</div>
					</section>

					<section class="home-practice">
						<div class="home-wrap home-practice-inner">
							<figure class="home-practice-media">
								<img
									src="/ui-assets/images/home-workshop.jpg"
									alt="Siswa berpraktik di bengkel otomotif sekolah didampingi guru"
									width="1392"
									height="752"
									loading="lazy"
									decoding="async"
								/>
							</figure>
							<div class="home-practice-copy">
								<p class="eyebrow">Fasilitas praktik</p>
								<h2>Ruang praktik yang dipakai setiap hari</h2>
								<p>
									Setiap program keahlian punya laboratorium atau bengkel sendiri,
									jadi jam produktif benar-benar dipakai untuk bekerja — bukan
									sekadar membaca modul.
								</p>
								<ul class="home-practice-list">
									for _, major := range page.Majors {
										if major.Detail != "" {
											<li>
												<span class="home-practice-code mono">{ major.Code }</span>
												<span>
													<strong>{ major.Detail }</strong>
													<span>{ major.Name }</span>
												</span>
											</li>
										}
									}
								</ul>
							</div>
						</div>
					</section>
				}

				if len(page.Partners) > 0 {
					<section class="home-section home-section-alt" id="mitra">
						<div class="home-wrap">
							<header class="home-section-head">
								<p class="eyebrow">Mitra industri</p>
								<h2>Tempat siswa belajar bekerja</h2>
								<p>
									Perusahaan yang sudah menerima siswa PKL. Nama pembimbing dan
									nomor kontaknya tetap di dalam portal.
								</p>
							</header>

							<ul class="home-partners">
								for _, partner := range page.Partners {
									<li class="home-partner">
										<span class="home-partner-icon">@components.Icon("briefcase", "icon")</span>
										<strong>{ partner.Name }</strong>
										if partner.Sector != "" {
											<span>{ partner.Sector }</span>
										}
									</li>
								}
							</ul>

							if page.Headmaster != "" {
								<div class="home-lead-note">
									<span class="home-lead-avatar" aria-hidden="true">{ ui.Initials(page.Headmaster) }</span>
									<div>
										<p class="home-lead-role">Kepala sekolah</p>
										<p class="home-lead-name">{ page.Headmaster }</p>
										<p class="home-lead-line">
											Menandatangani dokumen resmi secara elektronik dan memantau
											mutu akademik lewat portal yang sama.
										</p>
									</div>
								</div>
							}
						</div>
					</section>
				}

				<section class="home-section" id="akun">
					<div class="home-wrap">
						<header class="home-section-head">
							<p class="eyebrow">Cara dapat akun</p>
							<h2>Tidak ada pendaftaran mandiri</h2>
							<p>
								Akun dibuat oleh sekolah supaya hanya orang yang benar-benar
								terdaftar yang bisa masuk. Tiga langkahnya:
							</p>
						</header>

						<ol class="home-steps">
							<li class="home-step">
								<span class="home-step-num mono">01</span>
								<h3>Sekolah mendaftarkan Anda</h3>
								<p>Admin TU membuat akun dari data induk: siswa, guru, staf, atau wali murid.</p>
							</li>
							<li class="home-step">
								<span class="home-step-num mono">02</span>
								<h3>Terima identitas masuk</h3>
								<p>NISN atau NIP untuk siswa dan guru, nomor WhatsApp terdaftar untuk orang tua.</p>
							</li>
							<li class="home-step">
								<span class="home-step-num mono">03</span>
								<h3>Masuk dan amankan akun</h3>
								<p>Ganti kata sandi awal, lalu aktifkan verifikasi dua langkah untuk akun staf.</p>
							</li>
						</ol>

						<p class="home-steps-foot">
							Belum punya akun atau datanya salah?
							<a href="/contact">Kirim laporan lewat halaman bantuan</a>.
						</p>
					</div>
				</section>

				<section class="home-section home-section-alt" id="faq">
					<div class="home-wrap home-faq-wrap">
						<header class="home-section-head">
							<p class="eyebrow">Pertanyaan</p>
							<h2>Hal yang paling sering ditanyakan</h2>
						</header>

						<div class="home-faq">
							<details class="home-faq-item">
								<summary>Bagaimana cara mendapatkan akun?</summary>
								<p>
									Akun dibuat oleh sekolah, bukan lewat pendaftaran mandiri. Hubungi
									Admin TU atau wali kelas untuk didaftarkan.
								</p>
							</details>
							<details class="home-faq-item">
								<summary>Saya lupa kata sandi.</summary>
								<p>
									Buka halaman <a href="/contact">Bantuan &amp; laporan</a> dan sebutkan
									peran serta identitas Anda. Admin akan mengatur ulang kata sandi.
								</p>
							</details>
							<details class="home-faq-item">
								<summary>NISN atau NIP saya tidak dikenali.</summary>
								<p>
									Pastikan nomor yang dipakai sama dengan data induk sekolah. Kalau
									masih gagal, laporkan lewat halaman bantuan agar Admin TU memeriksa
									data Anda.
								</p>
							</details>
							<details class="home-faq-item">
								<summary>Orang tua tidak punya WhatsApp?</summary>
								<p>
									Portal keluarga memakai nomor WhatsApp wali yang terdaftar. Minta
									sekolah mengganti nomornya bila wali memakai nomor lain.
								</p>
							</details>
							<details class="home-faq-item">
								<summary>Bagaimana memastikan kwitansi atau surat itu asli?</summary>
								<p>
									Buka <a href="/verify">Verifikasi dokumen</a>, lalu masukkan nomor
									dokumen yang tertera. Sistem mencocokkan tanda tangan elektroniknya.
								</p>
							</details>
						</div>
					</div>
				</section>

				<section class="home-cta">
					<div class="home-wrap home-cta-inner">
						<div>
							<h2>Sudah punya akun sekolah?</h2>
							<p>Gunakan NISN, NIP, atau nomor WhatsApp orang tua yang terdaftar.</p>
						</div>
						<a class="button button-gold" href="/login">
							<span>Masuk ke Portal</span>
							@components.Icon("arrow-right", "icon")
						</a>
					</div>
				</section>
			</main>

			<footer class="home-footer">
				<div class="home-wrap home-footer-inner">
					<div class="home-footer-brand">
						<div class="home-lockup home-footer-lockup">
							<span class="home-mark" aria-hidden="true">SMK</span>
							<span class="home-lockup-copy">
								<strong>SMK Negeri 1 Rekayasa</strong>
								<span>Portal WESMK · { page.AcademicYear }</span>
							</span>
						</div>
					</div>
					<nav class="home-footer-cols" aria-label="Tautan kaki">
						<div>
							<p class="home-footer-title">Portal</p>
							<a href="/login">Masuk</a>
							<a href="/verify">Verifikasi dokumen</a>
						</div>
						<div>
							<p class="home-footer-title">Bantuan</p>
							<a href="/contact">Laporan &amp; kontak</a>
							<a href="#faq">Pertanyaan umum</a>
						</div>
					</nav>
				</div>
			</footer>
		</body>
	</html>
}

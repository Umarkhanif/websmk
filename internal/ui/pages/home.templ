package pages

import (
	"wesmk/internal/ui"
	"wesmk/internal/ui/components"
)

// Home is the public front door of the school. It answers "sekolah apa ini dan
// apa yang bisa saya lakukan di sini" before asking anyone to log in.
//
// Layout mengikuti referensi sfschool.org: utility strip, header dengan
// dropdown, hero slider berisi tagline, announcement, mission, kartu foto,
// statistik, divisions, testimoni, news, dan footer kaya. Login/role tidak
// berubah. Foto/konten fiktif; angka sekolah berasal dari DB.
templ Home(page ui.HomePage) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<meta name="color-scheme" content="light"/>
			<meta name="theme-color" content="#0F254C"/>
			<title>{ ui.SchoolName() } — Portal Layanan Sekolah</title>
			<meta name="description" content={ "Portal layanan " + ui.SchoolName() + ": akademik, keuangan, PKL, dan komunikasi sekolah untuk siswa, guru, orang tua, dan staf." }/>
			<link rel="canonical" href={ page.SiteURL + "/" }/>
			<meta property="og:type" content="website"/>
			<meta property="og:site_name" content={ ui.SchoolName() }/>
			<meta property="og:title" content={ ui.SchoolName() + " — Portal Layanan Sekolah" }/>
			<meta property="og:description" content={ "Portal layanan " + ui.SchoolName() + ": akademik, keuangan, PKL, dan komunikasi sekolah untuk siswa, guru, orang tua, dan staf." }/>
			<meta property="og:url" content={ page.SiteURL + "/" }/>
			<meta property="og:image" content={ page.SiteURL + "/ui-assets/images/home-hero.jpg" }/>
			<meta property="og:locale" content="id_ID"/>
			<meta name="twitter:card" content="summary_large_image"/>
			@templ.Raw(`<script type="application/ld+json">` + page.JSONLD + `</script>`)
			<link rel="icon" type="image/svg+xml" href="/ui-assets/favicon.svg"/>
			<link rel="manifest" href="/ui-assets/manifest.webmanifest"/>
			<link rel="apple-touch-icon" href="/ui-assets/apple-touch-icon.png"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-title" content="WESMK"/>
			<link rel="preload" href="/ui-assets/fonts/source-serif-4-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/ui-assets/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/ui-assets/images/home-hero.jpg" as="image"/>
			<link rel="stylesheet" href="/ui-assets/app.css?v=20261127o"/>
			<link rel="stylesheet" href="/ui-assets/landing.css?v=20261127b"/>
			<script src="/ui-assets/app.js?v=20261127o" defer></script>
		</head>
		<body class="sf-body">
			<a class="skip-link" href="#main-content">Lewati ke konten utama</a>

			<div class="sf-utility">
				<div class="sf-wrap sf-utility-inner">
					<span class="sf-utility-brand">{ ui.SchoolName() }</span>
					<nav class="sf-utility-links" aria-label="Tautan cepat">
						<a href="#berita">Berita</a>
						<a href="/verify">Verifikasi dokumen</a>
						<a href="/contact">Kontak</a>
						<a class="sf-utility-cta" href="/login">Masuk ke portal</a>
					</nav>
				</div>
			</div>

			<header class="sf-header">
				<div class="sf-wrap sf-header-inner">
					<a class="sf-logo" href="/" aria-label={ ui.SchoolName() + " beranda" }>
						<span class="sf-logo-mark" aria-hidden="true">{ ui.Initials(ui.SchoolName()) }</span>
						<span class="sf-logo-text">{ ui.SchoolName() }</span>
					</a>

					<nav class="sf-nav" aria-label="Navigasi utama">
						<details class="sf-drop">
							<summary>Tentang</summary>
							<div class="sf-drop-panel">
								<a href="#tentang">Tentang sekolah</a>
								<a href="#magic">Nilai &amp; pembelajaran</a>
								<a href="#keamanan">Keamanan</a>
								<a href="/contact">Kontak</a>
							</div>
						</details>
						<details class="sf-drop">
							<summary>Akademik</summary>
							<div class="sf-drop-panel">
								<a href="#program">Program keahlian</a>
								<a href="#layanan">Layanan portal</a>
							</div>
						</details>
						<details class="sf-drop">
							<summary>Kehidupan siswa</summary>
							<div class="sf-drop-panel">
								<a href="#siswa">Praktik &amp; bengkel</a>
								<a href="#mitra">Mitra industri</a>
							</div>
						</details>
						<details class="sf-drop">
							<summary>Pendaftaran</summary>
							<div class="sf-drop-panel">
								<a href="#pendaftaran">Cara dapat akun</a>
								<a href="#masuk">Pintu masuk peran</a>
								<a href="#faq">Pertanyaan umum</a>
							</div>
						</details>
						<a href="#berita">Berita</a>
					</nav>

					<div class="sf-header-actions">
						<a class="sf-btn sf-btn-ghost" href="#pendaftaran">Cara dapat akun</a>
						<a class="sf-btn sf-btn-primary" href="/login">Masuk ke portal</a>
						<details class="sf-menu">
							<summary class="sf-menu-btn" aria-label="Buka menu">
								<span class="sf-menu-bars" aria-hidden="true"></span>
							</summary>
							<nav class="sf-menu-panel" aria-label="Navigasi selengkapnya">
								<a href="#tentang">Tentang</a>
								<a href="#magic">Nilai &amp; pembelajaran</a>
								<a href="#program">Program keahlian</a>
								<a href="#siswa">Kehidupan siswa</a>
								<a href="#mitra">Mitra industri</a>
								<a href="#layanan">Layanan portal</a>
								<a href="#masuk">Pintu masuk peran</a>
								<a href="#pendaftaran">Cara dapat akun</a>
								<a href="#keamanan">Keamanan</a>
								<a href="#berita">Berita</a>
								<a href="#faq">Pertanyaan</a>
								<a href="/verify">Verifikasi dokumen</a>
								<a href="/contact">Bantuan &amp; laporan</a>
								<a class="sf-btn sf-btn-primary" href="/login">Masuk ke portal</a>
							</nav>
						</details>
					</div>
				</div>
			</header>

			<main id="main-content">
				<section class="sf-hero" aria-label="Sorotan">
					<div class="sf-hero-track" aria-hidden="true">
						<div class="sf-slide" style="background-image:url('/ui-assets/images/home-hero.jpg')"></div>
						<div class="sf-slide" style="background-image:url('/ui-assets/images/login-hero.jpg')"></div>
						<div class="sf-slide" style="background-image:url('/ui-assets/images/home-workshop.jpg')"></div>
						<div class="sf-slide" style="background-image:url('/ui-assets/images/login-campus.jpg')"></div>
					</div>
					<div class="sf-hero-overlay"></div>
					<div class="sf-hero-captions">
						<p class="sf-caption">Menumbuhkan potensi. Menghargai perbedaan.</p>
						<p class="sf-caption">Menumbuhkan cinta belajar seumur hidup.</p>
						<p class="sf-caption">Belajar praktik, tumbuh bersama industri.</p>
						<p class="sf-caption">Sekolah kejuruan dengan suasana kekeluargaan.</p>
					</div>
					<div class="sf-wrap sf-hero-foot">
						<p class="sf-kicker">{ ui.SchoolName() } · Tahun ajaran { page.AcademicYear }</p>
						<a class="sf-btn sf-btn-primary sf-btn-lg" href="/login">Masuk ke portal</a>
					</div>
				</section>

				<div class="sf-announce">
					<div class="sf-wrap sf-announce-inner">
						<img src="/ui-assets/images/home-hero.jpg" alt="Siswa di laboratorium komputer" width="1392" height="752" loading="lazy" decoding="async"/>
						<div class="sf-announce-copy">
							<h2>Pengenalan sekolah &amp; tur kampus sudah dibuka</h2>
							<p>Kenali program keahlian, fasilitas praktik, dan cara mendapatkan akun portal sekolah.</p>
						</div>
						<a class="sf-btn sf-btn-primary" href="#pendaftaran">Lihat cara dapat akun</a>
					</div>
				</div>

				<section class="sf-section sf-mission" id="tentang">
					<div class="sf-wrap sf-mission-inner">
						<p class="sf-eyebrow">Tentang sekolah</p>
						<h2>Sekolah kejuruan yang menumbuhkan karakter dan kompetensi</h2>
						<p>
							{ ui.SchoolName() } adalah sekolah menengah kejuruan yang menyiapkan siswa
							untuk kerja, kuliah, dan berwirausaha. Pembelajaran praktik di laboratorium
							dan bengkel dipadukan dengan kurikulum yang mengikuti kebutuhan dunia usaha
							dan industri, serta kemitraan PKL yang nyata.
						</p>
						<p class="sf-mission-quote">
							<em>{ ui.SchoolName() } menumbuhkan potensi setiap siswa dalam komunitas yang saling menghormati, menghargai keberagaman, dan mencintai pembelajaran.</em>
						</p>
					</div>
				</section>

				<section class="sf-section sf-alt" id="magic">
					<div class="sf-wrap">
						<header class="sf-head sf-head-center">
							<p class="sf-eyebrow">Keunggulan sekolah</p>
							<h2>Keseruan belajar di { ui.SchoolName() }</h2>
						</header>
						<div class="sf-photo-cards">
							<article class="sf-photo-card">
								<img src="/ui-assets/images/login-hero.jpg" alt="Siswa belajar di kelas" width="1800" height="1200" loading="lazy" decoding="async"/>
								<div class="sf-photo-card-body"><h3>Karakter &amp; kepedulian</h3><p>Kami menumbuhkan siswa yang baik dan berani, dengan rasa hormat dan tanggung jawab.</p><a class="sf-card-link" href="#tentang">Pelajari lebih lanjut</a></div>
							</article>
							<article class="sf-photo-card">
								<img src="/ui-assets/images/home-workshop.jpg" alt="Siswa praktik di bengkel sekolah" width="1392" height="752" loading="lazy" decoding="async"/>
								<div class="sf-photo-card-body"><h3>Belajar lewat praktik</h3><p>Proyek dan kolaborasi membuat siswa berpikir mendalam dan menjadi pembelajar seumur hidup.</p><a class="sf-card-link" href="#program">Pelajari lebih lanjut</a></div>
							</article>
							<article class="sf-photo-card">
								<img src="/ui-assets/images/login-lab.jpg" alt="Siswa bekerja di laboratorium" width="1000" height="667" loading="lazy" decoding="async"/>
								<div class="sf-photo-card-body"><h3>Fasilitas praktik</h3><p>Laboratorium dan bengkel dipakai setiap hari, jadi belajar benar-benar dekat dengan dunia kerja.</p><a class="sf-card-link" href="#siswa">Pelajari lebih lanjut</a></div>
							</article>
							<article class="sf-photo-card">
								<img src="/ui-assets/images/login-campus.jpg" alt="Upacara bendera di halaman sekolah" width="1100" height="730" loading="lazy" decoding="async"/>
								<div class="sf-photo-card-body"><h3>Rasa memiliki</h3><p>Komunitas yang hangat dan beragam memberi setiap siswa ruang untuk tumbuh.</p><a class="sf-card-link" href="#mitra">Pelajari lebih lanjut</a></div>
							</article>
						</div>
					</div>
				</section>

				if len(page.Stats) > 0 || page.AcademicYear != "" {
					<section class="sf-stats" aria-label="Sekolah dalam angka">
						<div class="sf-wrap sf-stats-grid">
							<div class="sf-stat"><strong>{ page.AcademicYear }</strong><span>Tahun ajaran</span></div>
							for _, stat := range page.Stats {
								<div class="sf-stat"><strong>{ stat.Value }</strong><span>{ stat.Label }</span></div>
							}
						</div>
					</section>
				}

				<section class="sf-section" id="program">
					<div class="sf-wrap">
						<header class="sf-head">
							<p class="sf-eyebrow">Program keahlian</p>
							<h2>Setiap jurusan punya jalannya sendiri</h2>
							<p>Siswa bergabung di program keahlian yang membangkitkan semangat belajar dan menyiapkan mereka untuk dunia kerja.</p>
						</header>
						if len(page.Majors) > 0 {
							<div class="sf-divisions">
								for _, major := range page.Majors {
									<article class="sf-division">
										<div class="sf-division-photo" aria-hidden="true"></div>
										<div class="sf-division-body">
											<p class="sf-eyebrow">{ major.Code }</p>
											<h3>{ major.Name }</h3>
											if major.Detail != "" {
												<p>{ major.Detail }</p>
											}
											if major.Head != "" {
												<p class="sf-muted">Ka. program: { major.Head }</p>
											}
											<a class="sf-card-link" href="#layanan">Lihat layanan portal</a>
										</div>
									</article>
								}
							</div>
						}
					</div>
				</section>

				<section class="sf-section sf-alt" id="siswa">
					<div class="sf-wrap sf-grid-2">
						<div class="sf-figure"><img src="/ui-assets/images/home-workshop.jpg" alt="Guru mendampingi siswa memeriksa mesin mobil di bengkel sekolah" width="1392" height="752" loading="lazy" decoding="async"/></div>
						<div class="sf-prose">
							<p class="sf-eyebrow">Kehidupan siswa</p>
							<h2>Ruang praktik yang dipakai setiap hari</h2>
							<p>Setiap program keahlian punya laboratorium atau bengkel sendiri, jadi jam produktif benar-benar dipakai untuk bekerja.</p>
							<a class="sf-btn sf-btn-primary" href="#program">Lihat program keahlian</a>
						</div>
					</div>
				</section>

				<section class="sf-testimonial">
					<div class="sf-wrap">
						<blockquote>
							<p>“Bersekolah di sini adalah salah satu keputusan terbaik untuk anak kami. Dia tumbuh percaya diri, dan kami pun ikut berkembang.”</p>
							<footer>— Orang tua siswa { ui.SchoolName() }</footer>
						</blockquote>
					</div>
				</section>

				<section class="sf-section" id="berita">
					<div class="sf-wrap">
						<header class="sf-head"><p class="sf-eyebrow">Berita &amp; kegiatan</p><h2>Kabar terbaru dari sekolah</h2></header>
						<div class="sf-news">
							<article class="sf-news-item">
								<img src="/ui-assets/images/home-workshop.jpg" alt="Siswa praktik mesin di bengkel" width="1392" height="752" loading="lazy" decoding="async"/>
								<div><p class="sf-news-date">21 September 2026</p><h3>Siswa mengikuti pelatihan jaringan bersama mitra industri</h3><p>Siswa belajar langsung di laboratorium dan bengkel mitra sebagai bagian dari kegiatan PKL.</p></div>
							</article>
							<article class="sf-news-item">
								<img src="/ui-assets/images/login-campus.jpg" alt="Upacara bendera di halaman sekolah" width="1100" height="730" loading="lazy" decoding="async"/>
								<div><p class="sf-news-date">29 Agustus 2026</p><h3>Upacara dan kegiatan komunitas sekolah</h3><p>Warga sekolah berkumpul untuk kegiatan bersama yang menumbuhkan rasa memiliki.</p></div>
							</article>
							<article class="sf-news-item">
								<img src="/ui-assets/images/login-hero.jpg" alt="Siswa mengerjakan tugas di kelas" width="1800" height="1200" loading="lazy" decoding="async"/>
								<div><p class="sf-news-date">27 Maret 2026</p><h3>Proyek kolaboratif siswa dalam pelajaran</h3><p>Belajar lewat proyek membantu siswa berpikir kritis dan bekerja tim.</p></div>
							</article>
						</div>
					</div>
				</section>

				<section class="sf-section sf-alt" id="layanan">
					<div class="sf-wrap">
						<header class="sf-head">
							<p class="sf-eyebrow">Layanan portal</p>
							<h2>Satu portal untuk keperluan sekolah sehari-hari</h2>
							<p>Fitur yang dipakai sekolah setiap hari, dari presensi sampai penyaluran kerja. Akun dibuat oleh sekolah.</p>
						</header>
						<ul class="sf-services">
							<li><strong>Presensi &amp; jurnal</strong><p>Kehadiran harian dan jurnal mengajar guru tercatat rapi.</p></li>
							<li><strong>Kuis, tugas, dan nilai</strong><p>Tugas, kuis, dan penilaian siswa dalam satu alur.</p></li>
							<li><strong>Ujian CBT</strong><p>Ujian berbasis komputer dengan sesi dan pemantauan.</p></li>
							<li><strong>Keuangan &amp; SPP</strong><p>Tagihan, pembayaran, dan kwitansi yang bisa diverifikasi.</p></li>
							<li><strong>PKL &amp; bursa kerja</strong><p>Penempatan PKL, jurnal harian, dan penyaluran kerja (BKK).</p></li>
							<li><strong>Administrasi akademik</strong><p>Data kelas, jadwal, dan wali kelas yang selalu terbaru.</p></li>
						</ul>
					</div>
				</section>

				if len(page.Partners) > 0 {
					<section class="sf-section sf-alt" id="mitra">
						<div class="sf-wrap">
							<header class="sf-head"><p class="sf-eyebrow">Mitra industri</p><h2>Tempat siswa belajar bekerja</h2><p>Perusahaan yang sudah menerima siswa PKL. Nama pembimbing dan nomor kontaknya tetap di dalam portal.</p></header>
							<ul class="sf-partners">
								for _, partner := range page.Partners {
									<li>
										<strong>{ partner.Name }</strong>
										if partner.Sector != "" {
											<span>{ partner.Sector }</span>
										}
									</li>
								}
							</ul>
							if page.Headmaster != "" {
								<div class="sf-lead">
									<span class="sf-lead-avatar" aria-hidden="true">{ ui.Initials(page.Headmaster) }</span>
									<div>
										<p class="sf-eyebrow">Kepala sekolah</p>
										<p class="sf-lead-name">{ page.Headmaster }</p>
										<p>Menandatangani dokumen resmi secara elektronik dan memantau mutu akademik lewat portal yang sama.</p>
									</div>
								</div>
							}
						</div>
					</section>
				}

				<section class="sf-section sf-alt" id="keamanan">
					<div class="sf-wrap">
						<header class="sf-head"><p class="sf-eyebrow">Keamanan &amp; kepercayaan</p><h2>Akun aman, data tetap terbatas</h2><p>Portal menyimpan data pribadi siswa, jadi aksesnya dijaga berlapis dan setiap dokumen bisa dilacak.</p></header>
						<ul class="sf-trust">
							<li><span class="sf-trust-icon">@components.Icon("lock", "icon")</span><span><strong>Verifikasi dua langkah</strong><span>Akun staf butuh lapisan kedua saat masuk, di luar kata sandi.</span></span></li>
							<li><span class="sf-trust-icon">@components.Icon("eye", "icon")</span><span><strong>Akses per peran</strong><span>Siswa, guru, dan orang tua hanya menerima datanya sendiri.</span></span></li>
							<li><span class="sf-trust-icon">@components.Icon("file-check", "icon")</span><span><strong>Tanda tangan elektronik</strong><span>Surat dan kwitansi resmi ditandatangani secara elektronik.</span></span></li>
							<li><span class="sf-trust-icon">@components.Icon("shield-alert", "icon")</span><span><strong>Verifikasi publik</strong><span>Nomor dokumen bisa dicek siapa saja lewat halaman verifikasi.</span></span></li>
						</ul>
					</div>
				</section>

				<section class="sf-section" id="masuk">
					<div class="sf-wrap sf-grid-2">
						<div class="sf-prose">
							<p class="sf-eyebrow">Pintu masuk</p>
							<h2>Masuk sesuai peran Anda</h2>
							<p>Setiap peran punya ruang kerjanya sendiri. Tidak ada data orang lain yang ikut terkirim ke layar Anda.</p>
							<p class="sf-muted"><a href="/verify">Verifikasi dokumen</a> · <a href="/contact">Bantuan &amp; laporan</a></p>
						</div>
						<div class="sf-gates">
							<a class="sf-gate" href="/login?tab=staff"><strong>Siswa, guru &amp; staf</strong><span>Masuk dengan NISN atau NIP</span><span class="sf-gate-tags">Presensi · jadwal · tugas · ujian CBT · nilai</span></a>
							<a class="sf-gate" href="/login?tab=parent"><strong>Orang tua &amp; wali</strong><span>Masuk dengan nomor WhatsApp terdaftar</span><span class="sf-gate-tags">Perkembangan anak · tagihan SPP · izin · komunikasi</span></a>
						</div>
					</div>
				</section>

				<section class="sf-section sf-alt" id="pendaftaran">
					<div class="sf-wrap">
						<header class="sf-head"><p class="sf-eyebrow">Pendaftaran</p><h2>Tidak ada pendaftaran mandiri</h2><p>Akun dibuat oleh sekolah supaya hanya orang yang benar-benar terdaftar yang bisa masuk.</p></header>
						<ol class="sf-steps">
							<li><span class="sf-step-num">01</span><h3>Sekolah mendaftarkan Anda</h3><p>Admin TU membuat akun dari data induk: siswa, guru, staf, atau wali murid.</p></li>
							<li><span class="sf-step-num">02</span><h3>Terima identitas masuk</h3><p>NISN atau NIP untuk siswa dan guru, nomor WhatsApp terdaftar untuk orang tua.</p></li>
							<li><span class="sf-step-num">03</span><h3>Masuk dan amankan akun</h3><p>Ganti kata sandi awal, lalu aktifkan verifikasi dua langkah untuk akun staf.</p></li>
						</ol>
					</div>
				</section>

				<section class="sf-section" id="faq">
					<div class="sf-wrap sf-faq-wrap">
						<header class="sf-head"><p class="sf-eyebrow">Pertanyaan</p><h2>Hal yang paling sering ditanyakan</h2></header>
						<div class="sf-faq">
							<details><summary>Bagaimana cara mendapatkan akun?</summary><p>Akun dibuat oleh sekolah, bukan lewat pendaftaran mandiri. Hubungi Admin TU atau wali kelas untuk didaftarkan.</p></details>
							<details><summary>Saya lupa kata sandi.</summary><p>Buka halaman <a href="/contact">Bantuan &amp; laporan</a> dan sebutkan peran serta identitas Anda. Admin akan mengatur ulang kata sandi.</p></details>
							<details><summary>NISN atau NIP saya tidak dikenali.</summary><p>Pastikan nomor yang dipakai sama dengan data induk sekolah. Kalau masih gagal, laporkan lewat halaman bantuan.</p></details>
							<details><summary>Orang tua tidak punya WhatsApp?</summary><p>Portal keluarga memakai nomor WhatsApp wali yang terdaftar. Minta sekolah mengganti nomornya bila wali memakai nomor lain.</p></details>
							<details><summary>Bagaimana memastikan kwitansi atau surat itu asli?</summary><p>Buka <a href="/verify">Verifikasi dokumen</a>, lalu masukkan nomor dokumen yang tertera.</p></details>
						</div>
					</div>
				</section>

				<section class="sf-reach">
					<div class="sf-wrap sf-grid-2">
						<div class="sf-prose">
							<p class="sf-eyebrow">Bantuan</p>
							<h2>Ada pertanyaan?</h2>
							<p>Lupa kata sandi, kendala akun, atau data yang perlu diperbaiki — sampaikan lewat halaman bantuan.</p>
							<a class="sf-btn sf-btn-primary" href="/contact">Hubungi sekolah</a>
						</div>
						<figure class="sf-figure"><img src="/ui-assets/images/login-campus.jpg" alt="Upacara bendera di halaman sekolah" width="1100" height="730" loading="lazy" decoding="async"/></figure>
					</div>
				</section>
			</main>


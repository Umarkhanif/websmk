package pages

import (
	"wesmk/internal/ui"
	"wesmk/internal/ui/components"
)

templ MagicLink(page ui.MagicLinkPage) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<meta name="color-scheme" content="light"/>
			<meta name="theme-color" content="#C60C46"/>
			<meta name="robots" content="noindex"/>
			<title>Konfirmasi Masuk — WESMK</title>
			<link rel="icon" type="image/svg+xml" href="/ui-assets/favicon.svg"/>
			<link rel="manifest" href="/ui-assets/manifest.webmanifest"/>
			<link rel="apple-touch-icon" href="/ui-assets/apple-touch-icon.png"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-title" content="WESMK"/>
			<link rel="preload" href="/ui-assets/fonts/poppins-400-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/ui-assets/fonts/poppins-700-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href="/ui-assets/app.css?v=20261128a"/>
		</head>
		<body class="app-body">
			<main class="page">
				<div class="page-stack" style="max-width:520px; margin:10vh auto;">
					<section class="card form-stack">
						<div class="stat-card-head">
							<div>
								<span class="eyebrow">Tautan Masuk Orang Tua</span>
								<h2>Konfirmasi Masuk</h2>
							</div>
							@components.Icon("lock", "icon")
						</div>
						<p class="muted">
							Klik tombol di bawah untuk memakai tautan sekali pakai ini. Demi keamanan,
							tautan tidak langsung aktif saat halaman dibuka oleh pratinjau pesan.
						</p>
						if page.Error != "" {
							<div class="alert alert-danger" role="alert">
								@components.Icon("alert", "icon")
								<span>{ page.Error }</span>
							</div>
						}
						<form method="post" action={ "/login/magic/" + page.Token } class="form-stack">
							<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
							<button type="submit" class="button button-primary">
								@components.Icon("arrow-right", "icon")
								<span>Masuk ke Portal</span>
							</button>
						</form>
						<a href="/login?tab=parent" class="button button-secondary button-small">Batal</a>
					</section>
				</div>
			</main>
		</body>
	</html>
}

package pages

import (
	"strconv"

	"wesmk/internal/ui"
	"wesmk/internal/ui/components"
)

templ PublicVerify(data ui.PublicVerifyPage) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<meta name="color-scheme" content="light"/>
			<meta name="theme-color" content="#C60C46"/>
			<title>Verifikasi Dokumen — { ui.SchoolName() }</title>
			<meta name="description" content={ "Verifikasi keaslian surat, kwitansi, dan jurnal PKL " + ui.SchoolName() + "." }/>
			<link rel="icon" type="image/svg+xml" href="/ui-assets/favicon.svg"/>
			<link rel="manifest" href="/ui-assets/manifest.webmanifest"/>
			<link rel="apple-touch-icon" href="/ui-assets/apple-touch-icon.png"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-title" content="WESMK"/>
			<link rel="preload" href="/ui-assets/fonts/poppins-400-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/ui-assets/fonts/poppins-700-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href="/ui-assets/app.css?v=20261128b"/>
			<script src="/ui-assets/htmx.min.js" defer></script>
			<script src="/ui-assets/app.js?v=20261128p" defer></script>
		</head>
		<body class="app-body">
			<header class="public-topbar">
				<div class="public-topbar-inner">
					<a class="public-brand" href="/" aria-label={ ui.SchoolName() + " beranda" }>
						<img src="/ui-assets/images/logo-emblem.png" alt="" width="120" height="108"/>
						<span><strong>{ ui.SchoolName() }</strong><small>Portal Layanan Sekolah</small></span>
					</a>
					<nav class="public-topbar-nav" aria-label="Navigasi publik">
						<a href="/">Beranda</a>
						<a href="/contact">Bantuan</a>
						<a class="button button-primary button-small" href="/login">Masuk</a>
					</nav>
				</div>
			</header>
			<main class="page public-main">
				<div class="page-stack">
					<section class="identity-card">
						<div class="identity-main">
							<span class="brand-mark brand-mark-lg">{ ui.Initials(ui.SchoolName()) }</span>
							<div class="identity-copy">
								<span class="eyebrow">Verifikasi Dokumen &amp; Mitra PKL</span>
								<h2>Pemeriksaan Keaslian Dokumen Resmi</h2>
								<p class="muted">{ ui.SchoolName() } · Cek keabsahan kwitansi, surat sekolah, dan persetujuan jurnal PKL.</p>
							</div>
						</div>
						<a href="/login" class="button button-secondary button-small">Kembali ke Portal</a>
					</section>

					<div class="login-tabs" role="tablist">
						<a href="/verify?tab=verify" class={ loginTabClass(data.ActiveTab, "verify") }>Verifikasi Dokumen</a>
						<a href="/verify?tab=dudi" class={ loginTabClass(data.ActiveTab, "dudi") }>Jurnal PKL</a>
					</div>

					if data.Error != "" {
						<div class="alert alert-danger" role="alert">
							@components.Icon("alert", "icon")
							<span>{ data.Error }</span>
						</div>
					}
					if data.Notice != "" {
						<div class="alert alert-success" role="status">
							@components.Icon("check", "icon")
							<span>{ data.Notice }</span>
						</div>
					}

					if data.ActiveTab == "dudi" {
						<section class="card form-stack">
							<div class="stat-card-head">
								<div>
									<span class="eyebrow">Persetujuan Pembimbing Industri</span>
									<h3>Validasi Jurnal PKL Siswa</h3>
								</div>
								@components.InfoBubble("Supervisor mitra industri memasukkan kode jurnal dan PIN otorisasi untuk mengesahkan aktivitas magang siswa.")
							</div>

							<form method="get" action="/verify" class="form-stack">
								<input type="hidden" name="tab" value="dudi"/>
								<div class="field">
									<div class="field-head">
										<label class="field-label" for="dudi-query">Kode Jurnal PKL</label>
										@components.InfoBubble("Kode jurnal tercantum pada tautan atau QR jurnal yang dikirim sekolah kepada supervisor mitra.")
									</div>
									<input id="dudi-query" class="input input-mono" type="text" name="q" value={ data.Query } placeholder="Mis. pkl-jrn-0001" required/>
								</div>
								<button type="submit" class="button button-primary">
									@components.Icon("file-check", "icon")
									<span>Cari Jurnal</span>
								</button>
							</form>

							if data.NotFound {
								<div class="alert alert-danger" role="alert">
									@components.Icon("alert", "icon")
									<span>Jurnal dengan kode "{ data.Query }" tidak ditemukan.</span>
								</div>
							}

							if data.SelectedJournal != nil {
								<div class="stat-card-head">
									<div>
										<span class="eyebrow">Jurnal { data.SelectedJournal.ID }</span>
										<h3>{ data.SelectedJournal.StudentName } — { data.SelectedJournal.CompanyName }</h3>
									</div>
									<span class="badge badge-neutral">{ data.SelectedJournal.Date }</span>
								</div>
								<div class="info-strip">
									<span class="info-strip-label">Aktivitas</span>
									<strong>{ data.SelectedJournal.ActivityTitle }</strong>
									<span class="muted">{ data.SelectedJournal.CompetencyLearned }</span>
								</div>
								<div class="flex-actions" style="display:flex; gap:8px; flex-wrap:wrap;">
									if data.SelectedJournal.SupervisorApproved {
										<span class="badge badge-success">Disetujui DUDI</span>
									} else {
										<span class="badge badge-warning">Menunggu PIN DUDI</span>
									}
									if data.SelectedJournal.TeacherApproved {
										<span class="badge badge-success">ACC Pembimbing</span>
									} else {
										<span class="badge badge-neutral">Menunggu Guru</span>
									}
								</div>

								if !data.SelectedJournal.SupervisorApproved {
									<form method="post" action="/verify/dudi-approve" class="form-stack">
										<input type="hidden" name="_csrf" value={ data.CSRFToken }/>
										<input type="hidden" name="journal_id" value={ data.SelectedJournal.ID }/>
										<div class="field">
											<div class="field-head">
												<label class="field-label" for="dudi-pin">PIN Supervisor DUDI</label>
												@components.InfoBubble("Masukkan PIN resmi dari nota kerja sama sekolah dengan mitra industri.")
											</div>
											<input id="dudi-pin" class="input input-mono" type="password" name="pin" placeholder="••••••" required/>
										</div>
										<button type="submit" class="button button-primary">
											@components.Icon("check", "icon")
											<span>Sahkan Jurnal Magang</span>
										</button>
									</form>
								}
							}
						</section>
					} else {
						<section class="card form-stack">
							<form method="get" action="/verify" class="form-stack">
								<div class="field">
									<div class="field-head">
										<label class="field-label" for="verify-query">Nomor Dokumen / Kwitansi / Kode Validasi</label>
										@components.InfoBubble("Masukkan nomor surat resmi, nomor kwitansi pembayaran, atau kode hash HMAC.")
									</div>
									<input id="verify-query" class="input input-mono" type="text" name="q" value={ data.Query } placeholder="Mis. SURAT/2026/048 atau KWT-202610-001..." required/>
								</div>
								<button type="submit" class="button button-primary">
									@components.Icon("file-check", "icon")
									<span>Periksa Keaslian Dokumen</span>
								</button>
							</form>
						</section>

						if data.VerifiedLetter != nil {
							<section class="card form-stack">
								<div class="stat-card-head">
									<span class="badge badge-success">SURAT RESMI TERVERIFIKASI</span>
									<span class="mono">{ data.VerifiedLetter.LetterNumber }</span>
								</div>
								<h3>{ data.VerifiedLetter.LetterType } — { data.VerifiedLetter.StudentName }</h3>
								<p class="muted">Tujuan: { data.VerifiedLetter.Recipient } · Tanggal Terbit: { data.VerifiedLetter.IssueDate }</p>
								<div class="info-strip">
									<span class="info-strip-label">Penandatangan</span>
									<strong>{ data.VerifiedLetter.SignerName } ({ data.VerifiedLetter.SignerRole })</strong>
									<span class="mono">HMAC-SHA256: { data.VerifiedLetter.HmacHash }</span>
								</div>
							</section>
						}

						if data.VerifiedReceipt != nil {
							<section class="card form-stack">
								<div class="stat-card-head">
									<span class="badge badge-success">KWITANSI PEMBAYARAN SAH</span>
									<span class="mono">{ data.VerifiedReceipt.ReceiptNumber }</span>
								</div>
								<h3>{ data.VerifiedReceipt.StudentName } — { ui.FormatRupiah(data.VerifiedReceipt.AmountDelta) }</h3>
								<p class="muted">Jenis Transaksi: { data.VerifiedReceipt.TxType } · Petugas/Kanal: { data.VerifiedReceipt.ActorName } · Waktu: { ui.FormatDateID(data.VerifiedReceipt.CreatedAt) }</p>
								<div class="info-strip">
									<span class="info-strip-label">Validasi Buku Kas (#{ strconv.FormatInt(data.VerifiedReceipt.ID, 10) })</span>
									<span class="mono">{ data.VerifiedReceipt.SignatureHmac }</span>
								</div>
							</section>
						}

						if data.NotFound {
							<section class="card">
								<div class="alert alert-danger">
									@components.Icon("alert", "icon")
									<span>Dokumen atau kwitansi dengan kode "{ data.Query }" tidak ditemukan di buku induk server.</span>
								</div>
							</section>
						}
					}
				</div>
			</main>
			<footer class="public-foot">
				<div class="public-foot-inner">
					<span>© { ui.SchoolName() } · Portal WESMK</span>
					<span><a href="/">Beranda</a> · <a href="/contact">Bantuan</a> · <a href="/login">Masuk</a></span>
				</div>
			</footer>
		</body>
	</html>
}

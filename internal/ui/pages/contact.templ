package pages

import (
	"wesmk/internal/ui"
	"wesmk/internal/ui/components"
)

templ Contact(data ui.ContactPage) {
	<div class="page-stack">
		<section class="card form-stack">
			<div class="stat-card-head">
				<div>
					<span class="eyebrow">Bantuan Pengguna</span>
					<h2>Hubungi Sekolah &amp; Laporkan Kendala</h2>
				</div>
				@components.InfoBubble("Laporan diteruskan ke tim teknis sekolah untuk ditelusuri dan ditindaklanjuti.")
			</div>

			<p class="muted">
				Mengalami kendala saat masuk, presensi, ujian, atau pembayaran? Sampaikan detailnya melalui form di bawah ini
				agar tim teknis sekolah dapat menelusuri penyebabnya dan menindaklanjuti dengan tepat.
			</p>

			<form method="post" action="/contact/report-bug" class="form-stack">
				<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>

				<div class="grid-2">
					<label class="field">
						<div class="field-head">
							<span class="field-label">Nama Pelapor</span>
							@components.InfoBubble("Nama Anda untuk konfirmasi tindak lanjut oleh tim teknis.")
						</div>
						<input class="input" name="reporter_name" value={ data.ReporterName } placeholder="Contoh: Budi Santoso atau Pengawas Lab 1" required/>
					</label>

					<label class="field">
						<div class="field-head">
							<span class="field-label">Kontak WhatsApp / Email</span>
							@components.InfoBubble("Nomor atau email aktif untuk pemberitahuan status tiket.")
						</div>
						<input class="input" name="reporter_email" value={ data.ReporterEmail } placeholder="0812xxxx atau nama@sekolah.sch.id"/>
					</label>
				</div>

				<div class="grid-2">
					<label class="field">
						<div class="field-head">
							<span class="field-label">Peran Pengguna</span>
							@components.InfoBubble("Pilih peran Anda saat kendala terjadi untuk memudahkan isolasi hak akses.")
						</div>
						<select class="input" name="reporter_role">
							<option value="student" selected?={ data.ReporterRole == "student" }>Murid / Siswa</option>
							<option value="teacher" selected?={ data.ReporterRole == "teacher" }>Guru / Pengawas Ujian</option>
							<option value="treasurer" selected?={ data.ReporterRole == "treasurer" }>Bendahara Sekolah</option>
							<option value="discipline" selected?={ data.ReporterRole == "discipline" }>Kesiswaan &amp; BK</option>
							<option value="piket" selected?={ data.ReporterRole == "piket" }>Guru Piket</option>
							<option value="admin_tu" selected?={ data.ReporterRole == "admin_tu" }>Admin Tata Usaha</option>
							<option value="parent" selected?={ data.ReporterRole == "parent" }>Orang Tua Murid</option>
							<option value="headmaster" selected?={ data.ReporterRole == "headmaster" }>Kepala Sekolah</option>
							<option value="guest" selected?={ data.ReporterRole == "guest" || data.ReporterRole == "" }>Pengunjung / Tamu</option>
						</select>
					</label>

					<label class="field">
						<div class="field-head">
							<span class="field-label">Kategori kendala</span>
							@components.InfoBubble("Modul sistem yang terdampak oleh kendala.")
						</div>
						<select class="input" name="category">
							<option value="CBT_EXAM" selected>Ujian Online (CBT / Kiosk / Kunci Layar)</option>
							<option value="ATTENDANCE_GATE">Presensi Gerbang &amp; Tap Kartu RFID</option>
							<option value="RAPOR_HOLISTIK">e-Rapor 360° &amp; Nilai Siswa</option>
							<option value="FINANCE_SPP">Keuangan, SPP &amp; Kwitansi Digital</option>
							<option value="UI_UX">Tampilan di HP / perangkat</option>
							<option value="AUTH_ACCESS">Masuk, kata sandi, &amp; akses akun</option>
							<option value="OTHER">Lainnya / Pertanyaan Umum</option>
						</select>
					</label>
				</div>

				<div class="grid-2">
					<label class="field">
						<div class="field-head">
							<span class="field-label">Tingkat urgensi</span>
							@components.InfoBubble("Pilih 'Kritis' jika ujian terhenti total atau data siswa terancam.")
						</div>
						<select class="input" name="severity">
							<option value="medium" selected>Sedang — kendala biasa, layanan utama masih berjalan</option>
							<option value="critical">Kritis — ujian atau layanan berhenti total</option>
							<option value="major">Tinggi — fungsi penting tidak merespons</option>
							<option value="low">Rendah — usulan perbaikan atau kendala tampilan kecil</option>
						</select>
					</label>

					<label class="field">
						<div class="field-head">
							<span class="field-label">Halaman terkait</span>
							@components.InfoBubble("Halaman tempat kendala muncul (otomatis dari browser jika ada).")
						</div>
						<input class="input" name="page_url" value={ data.RefererURL } placeholder="/student/exam-kiosk"/>
					</label>
				</div>

				<label class="field">
					<div class="field-head">
						<span class="field-label">Ringkasan kendala</span>
						@components.InfoBubble("Deskripsi singkat satu kalimat mengenai gejala kendala.")
					</div>
					<input class="input" name="title" placeholder="Contoh: Tombol mulai ujian tidak merespons pada siswa nomor meja 14" required/>
				</label>

				<label class="field">
					<div class="field-head">
						<span class="field-label">Detail kendala</span>
						@components.InfoBubble("Ceritakan kronologi: apa yang Anda klik, apa yang terjadi, dan pesan kendala jika ada.")
					</div>
					<textarea class="input" name="description" rows="5" placeholder="1. Saya membuka menu Pengawasan Ujian&#10;2. Menekan tombol Buka Kunci untuk siswa NISN 0058471292&#10;3. Muncul pesan kendala dan layar siswa tetap terkunci" required></textarea>
				</label>

				<div class="field-actions">
					<a href={ templ.SafeURL(ui.RoleHome(data.Shell.Role)) } class="button button-secondary">Kembali ke Portal</a>
					<button type="submit" class="button button-primary">
						@components.Icon("help", "icon-xs")
						<span>Kirim Laporan</span>
					</button>
				</div>
			</form>
		</section>

		<!-- Tindak lanjut laporan -->
		<section class="card note-card" style="display:flex; gap:16px; align-items:flex-start;">
			<div class="note-icon" style="flex-shrink:0;">
				@components.Icon("shield-alert", "icon")
			</div>
			<div>
				<h4>Tindak lanjut laporan</h4>
				<p class="muted" style="margin-top:4px;">
					Setiap laporan dicatat dan diteruskan ke tim teknis sekolah. Kendala yang menghentikan ujian
					atau mengancam data siswa ditangani lebih dahulu.
				</p>
			</div>
		</section>
	</div>
}

package pages

import (
	"strconv"

	"wesmk/internal/ui"
	"wesmk/internal/ui/components"
)

templ ParentPortal(data ui.ParentPortalPage) {
	<div class="page-stack">
		<section class="identity-card">
			<div class="identity-main">
				<span class="avatar avatar-lg">{ ui.Initials(data.Student.FullName) }</span>
				<div class="identity-copy">
					<span class="eyebrow">Portal Orang Tua</span>
					<h2>Kabar Belajar Ananda: { data.Student.FullName }</h2>
					<p class="identity-meta mono">Kelas { data.Student.ClassroomName } · NISN { data.Student.NISN }</p>
				</div>
			</div>
			<div class="appreciation-card">
				<span class="appreciation-icon">@components.Icon("award", "icon")</span>
				<div>
					<span class="eyebrow">Apresiasi Siswa</span>
					<strong>{ data.Student.ActiveBadge }</strong>
					<p>“{ data.Student.ActiveBadgeReason }”</p>
				</div>
			</div>
		</section>

		if data.Tab == "dashboard" {
			<div class="dashboard-grid">
				<article class="card stat-card">
					<div class="stat-card-head">
						<span class="eyebrow">Presensi Hari Ini</span>
						<span class={ "badge " + attendanceBadgeClass(data.Attendance.Status) }>{ data.Attendance.StatusLabel }</span>
					</div>
					<p class="stat-value mono">{ data.Attendance.Time }</p>
					<p class="stat-note">{ data.Attendance.Source }</p>
				</article>

				<article class="card stat-card">
					<div class="stat-card-head">
						<span class="eyebrow">Rapor Holistik 360°</span>
						<span class="badge badge-teal">Komprehensif</span>
					</div>
					<p class="stat-value mono">{ data.HolisticScore }/100</p>
					<p class="stat-note">Kuis: { strconv.Itoa(data.Student.DailyQuizAvg) } · Sikap: { strconv.Itoa(data.Student.AttitudeScore) }</p>
				</article>

				<article class="card stat-card">
					<div class="stat-card-head">
						<span class="eyebrow">Pemahaman Materi</span>
						<span class="badge badge-gold">{ data.ReflectionLevel }</span>
					</div>
					<p class="stat-title">Catatan Wali Kelas</p>
					<p class="stat-note">“{ data.Student.HomeroomNote }”</p>
				</article>
			</div>

			<section class="card form-stack">
				<span class="eyebrow">Saran Obrolan Keluarga</span>
				<h3>Topik Obrolan Malam Ini</h3>
				<div class="info-strip">
					<strong>Saran Diskusi:</strong>
					<span>“Bagaimana praktik bengkel hari ini, Nak? Sekolah mengapresiasi kedisiplinan dan keaktifanmu minggu ini.”</span>
				</div>
			</section>
		} else if data.Tab == "roadmap" {
			<section class="card form-stack">
				<span class="eyebrow">Rencana Biaya</span>
				<h2>Perjalanan Biaya Pendidikan (3 Tahun)</h2>
				<div class="dashboard-grid">
					<div class="info-strip">
						<span class="badge badge-teal">Tahun 1 · Kelas X</span>
						<h4>Fondasi &amp; Kunjungan Industri</h4>
						<p class="muted">Seragam bengkel, dasar kejuruan, dan orientasi industri.</p>
					</div>
					<div class="info-strip">
						<span class="badge badge-gold">Tahun 2 · Kelas XI</span>
						<h4>Praktik Kerja Lapangan (PKL)</h4>
						<p class="muted">Magang DUDI, asuransi kerja, dan jurnal kompetensi.</p>
					</div>
					<div class="info-strip">
						<span class="badge badge-success">Tahun 3 · Kelas XII</span>
						<h4>Uji Kompetensi Keahlian (UKK)</h4>
						<p class="muted">Sertifikasi BNSP, portofolio akhir, dan penyaluran BKK.</p>
					</div>
				</div>
			</section>

			<section class="card form-stack">
				<div class="stat-card-head">
					<h3>Rekap Pengeluaran Alat Praktik</h3>
					<strong class="mono">{ ui.FormatRupiah(data.TotalExpense) }</strong>
				</div>
				<div class="table-wrap">
					<table class="data-table">
						<thead>
							<tr>
								<th>Tanggal</th>
								<th>Kategori</th>
								<th>Kebutuhan</th>
								<th>Nominal</th>
								<th>Keterangan</th>
							</tr>
						</thead>
						<tbody>
							for _, e := range data.Expenses {
								<tr>
									<td class="mono">{ e.Date }</td>
									<td>{ e.Category }</td>
									<td><strong>{ e.ItemTitle }</strong></td>
									<td class="mono">{ ui.FormatRupiah(e.Amount) }</td>
									<td>{ e.ReceiptNote }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		} else if data.Tab == "future-plan" {
			<section class="card form-stack">
				<span class="eyebrow">Konsultasi Karir (BMW)</span>
				<h2>Jalur Karir Ananda ({ data.Student.FullName })</h2>
				<p class="muted">Pilihan minat saat ini: <strong>{ data.Student.BMWChoice }</strong></p>

				<div class="dashboard-grid">
					<div class="info-strip">
						<span class="badge badge-teal">Bekerja (DUDI)</span>
						<h4>Network Specialist</h4>
						<p class="muted">Mitra BKK: PT Telkom Akses &amp; PT Biznet Gio.</p>
					</div>
					<div class="info-strip">
						<span class="badge badge-gold">Kuliah Vokasi</span>
						<h4>D4 Teknik Telekomunikasi</h4>
						<p class="muted">Peluang beasiswa vokasi via Rapor 360°.</p>
					</div>
					<div class="info-strip">
						<span class="badge badge-success">Wirausaha</span>
						<h4>Teknisi &amp; Jasa Jaringan</h4>
						<p class="muted">Pendampingan unit produksi dan modal alat.</p>
					</div>
				</div>

				<form method="post" action="/parent/consultation" class="form-stack">
					<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
					<h3>Ajukan Konsultasi Karir BMW</h3>
					<div class="form-row">
						<label class="field">
							<span class="field-label">Jalur Pilihan</span>
							<select class="input" name="chosen_path">
								<option value="BEKERJA">Bekerja di Industri (BKK)</option>
								<option value="MELANJUTKAN">Kuliah Vokasi</option>
								<option value="WIRAUSAHA">Wirausaha Mandiri</option>
							</select>
						</label>
						<label class="field">
							<span class="field-label">Catatan / Pertanyaan Ortu</span>
							<input class="input" type="text" name="topic_note" placeholder="Contoh: Peluang kerja setelah magang..." required/>
						</label>
					</div>
					<button type="submit" class="button button-primary">Ajukan Jadwal Konsultasi</button>
				</form>

				<div class="table-wrap">
					<table class="data-table">
						<thead>
							<tr>
								<th>Tanggal</th>
								<th>Jalur</th>
								<th>Topik Konsultasi</th>
								<th>Status BK</th>
							</tr>
						</thead>
						<tbody>
							for _, c := range data.Consultations {
								<tr>
									<td class="mono">{ c.CreatedAt }</td>
									<td><span class="badge badge-teal">{ c.ChosenPath }</span></td>
									<td>{ c.TopicNote }</td>
									<td><span class="badge badge-gold">{ c.Status }</span></td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		} else if data.Tab == "services" {
			<div class="grid-2">
				<section class="card form-stack">
					<span class="eyebrow">Izin Kehadiran</span>
					<h2>Surat Izin / Sakit Resmi</h2>
					<p class="muted">Tersambung langsung ke presensi kelas guru mapel.</p>
					<form method="post" action="/parent/leave" class="form-stack">
						<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
						<div class="form-row">
							<label class="field">
								<span class="field-label">Jenis Keterangan</span>
								<select class="input" name="leave_type">
									<option value="SAKIT">Sakit (Istirahat / Berobat)</option>
									<option value="IZIN">Izin Keperluan Keluarga</option>
								</select>
							</label>
							<label class="field">
								<span class="field-label">Tanggal</span>
								<input class="input input-mono" type="date" name="leave_date" value="2026-10-25" required/>
							</label>
						</div>
						<label class="field">
							<span class="field-label">Keterangan</span>
							<input class="input" type="text" name="leave_note" placeholder="Keterangan sakit / keperluan..." required/>
						</label>
						<button type="submit" class="button button-primary">Kirim Surat Izin</button>
					</form>
				</section>

				<section class="card form-stack">
					<span class="eyebrow">Pembayaran SPP</span>
					<h3>Tagihan &amp; Kwitansi Digital</h3>
					for _, inv := range data.Invoices {
						<div class="info-strip">
							<div class="stat-card-head">
								<strong>SPP { inv.Period } ({ inv.Number })</strong>
								<span class={ "badge " + statusBadgeClass(inv.Status) }>{ inv.StatusLabel }</span>
							</div>
							<span class="mono">Total: { ui.FormatRupiah(inv.FinalAmount) } · Sisa: { ui.FormatRupiah(inv.Remaining) }</span>
							<span class="muted">VA { inv.Provider }: <strong class="mono">{ inv.VANumber }</strong></span>
							if !inv.IsPaid && data.Shell.DemoMode {
								<form method="post" action="/parent/invoice/pay">
									<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
									<input type="hidden" name="invoice_id" value={ inv.ID }/>
									<button type="submit" class="button button-secondary button-small">Simulasi Bayar VA</button>
								</form>
							}
						</div>
					}

					<h4>Kwitansi Digital Terverifikasi</h4>
					for _, item := range data.Ledger {
						<div class="info-strip">
							<div class="stat-card-head">
								<strong class="mono">{ item.ReceiptNumber }</strong>
								<strong class="mono">{ ui.FormatRupiah(item.AmountDelta) }</strong>
							</div>
							<span class="muted">{ item.TxType } · { ui.FormatDateID(item.CreatedAt) }</span>
							<a class="text-link" href={ "/verify?q=" + item.ReceiptNumber }>Verifikasi Keaslian HMAC Kwitansi</a>
						</div>
					}
				</section>
			</div>
		}
	</div>
}

package pages

import (
	"strconv"

	"wesmk/internal/ui"
	"wesmk/internal/ui/components"
)

templ ParentPortal(data ui.ParentPortalPage) {
	<div class="page-stack">
		<section class="identity-card">
			<div class="identity-main">
				<span class="avatar avatar-lg">{ ui.Initials(data.Student.FullName) }</span>
				<div class="identity-copy">
					<span class="eyebrow">Dashboard Empatik Orang Tua / Wali Murid</span>
					<h2>Kabar Harian Ananda: { data.Student.FullName }</h2>
					<p class="identity-meta mono">Kelas { data.Student.ClassroomName } · NISN { data.Student.NISN }</p>
				</div>
			</div>
			<div class="appreciation-card">
				<span class="appreciation-icon">@components.Icon("award", "icon")</span>
				<div>
					<span class="eyebrow">Apresiasi Sekolah</span>
					<strong>{ data.Student.ActiveBadge }</strong>
					<p>“{ data.Student.ActiveBadgeReason }”</p>
				</div>
			</div>
		</section>

		if data.Tab == "dashboard" {
			<div class="dashboard-grid">
				<article class="card stat-card">
					<div class="stat-card-head">
						<span class="eyebrow">Kehadiran Hari Ini</span>
						<span class={ "badge " + attendanceBadgeClass(data.Attendance.Status) }>{ data.Attendance.StatusLabel }</span>
					</div>
					<p class="stat-value mono">{ data.Attendance.Time }</p>
					<p class="stat-note">{ data.Attendance.Source }</p>
				</article>

				<article class="card stat-card">
					<div class="stat-card-head">
						<span class="eyebrow">Capaian Holistik 360°</span>
						<span class="badge badge-teal">Tanpa Ranking Kaku</span>
					</div>
					<p class="stat-value mono">{ data.HolisticScore }/100</p>
					<p class="stat-note">Rata-rata Kuis: { strconv.Itoa(data.Student.DailyQuizAvg) } · Sikap: { strconv.Itoa(data.Student.AttitudeScore) }</p>
				</article>

				<article class="card stat-card">
					<div class="stat-card-head">
						<span class="eyebrow">Radar Pemahaman Kelas</span>
						<span class="badge badge-gold">{ data.ReflectionLevel }</span>
					</div>
					<p class="stat-title">Catatan Wali Kelas</p>
					<p class="stat-note">“{ data.Student.HomeroomNote }”</p>
				</article>
			</div>

			<section class="card form-stack">
				<span class="eyebrow">Kemitraan Keluarga &amp; Sekolah</span>
				<h3>Panduan Dialog Hangat Meja Makan Malam Ini</h3>
				<div class="info-strip">
					<strong>Topik Obrolan Positif Malam Ini:</strong>
					<span>“Tadi di bengkel TKJ belajar konfigurasi jaringan apa, Nak? Wali kelasmu menyampaikan apresiasi atas kedisiplinanmu minggu ini.”</span>
				</div>
			</section>
		} else if data.Tab == "roadmap" {
			<section class="card form-stack">
				<span class="eyebrow">Perencanaan Keuangan Keluarga</span>
				<h2>Roadmap Perjalanan Biaya Pendidikan 3 Tahun (Kelas X – XII)</h2>
				<div class="dashboard-grid">
					<div class="info-strip">
						<span class="badge badge-teal">Tahun 1 · Kelas X</span>
						<h4>Fondasi &amp; Kunjungan Industri</h4>
						<p class="muted">Seragam praktik bengkel, modul dasar kejuruan, dan orientasi industri mitra.</p>
					</div>
					<div class="info-strip">
						<span class="badge badge-gold">Tahun 2 · Kelas XI</span>
						<h4>Praktik Kerja Lapangan (PKL 6 Bulan)</h4>
						<p class="muted">Transportasi magang DUDI, asuransi kerja siswa, dan jurnal kompetensi industri.</p>
					</div>
					<div class="info-strip">
						<span class="badge badge-success">Tahun 3 · Kelas XII</span>
						<h4>Uji Kompetensi Keahlian (UKK/LSP)</h4>
						<p class="muted">Sertifikasi profesi BNSP, portofolio proyek akhir, dan penyaluran Bursa Kerja Khusus (BKK).</p>
					</div>
				</div>
			</section>

			<section class="card form-stack">
				<div class="stat-card-head">
					<h3>Rekap Pengeluaran Alat Praktik Ananda</h3>
					<strong class="mono">{ ui.FormatRupiah(data.TotalExpense) }</strong>
				</div>
				<div class="table-wrap">
					<table class="data-table">
						<thead>
							<tr>
								<th>Tanggal</th>
								<th>Kategori</th>
								<th>Kebutuhan</th>
								<th>Nominal</th>
								<th>Keterangan</th>
							</tr>
						</thead>
						<tbody>
							for _, e := range data.Expenses {
								<tr>
									<td class="mono">{ e.Date }</td>
									<td>{ e.Category }</td>
									<td><strong>{ e.ItemTitle }</strong></td>
									<td class="mono">{ ui.FormatRupiah(e.Amount) }</td>
									<td>{ e.ReceiptNote }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		} else if data.Tab == "future-plan" {
			<section class="card form-stack">
				<span class="eyebrow">Konsultasi Masa Depan Lulusan (BMW)</span>
				<h2>Peta Bakat &amp; Rekomendasi Jalur Karir Ananda ({ data.Student.FullName })</h2>
				<p class="muted">Minat utama ananda saat ini: <strong>{ data.Student.BMWChoice }</strong></p>

				<div class="dashboard-grid">
					<div class="info-strip">
						<span class="badge badge-teal">Jalur Bekerja (DUDI)</span>
						<h4>Network &amp; Fiber Splicing Specialist</h4>
						<p class="muted">Mitra BKK: PT Telkom Akses &amp; PT Biznet Gio Nusantara.</p>
					</div>
					<div class="info-strip">
						<span class="badge badge-gold">Jalur Melanjutkan</span>
						<h4>D4 Teknik Telekomunikasi Politeknik</h4>
						<p class="muted">Peluang beasiswa vokasi berprestasi berdasarkan portofolio Rapor 360°.</p>
					</div>
					<div class="info-strip">
						<span class="badge badge-success">Jalur Wirausaha</span>
						<h4>Jasa Instalasi Jaringan &amp; RT/RW Net</h4>
						<p class="muted">Inkubasi unit produksi SMK dan pendampingan modal alat kerja.</p>
					</div>
				</div>

				<form method="post" action="/parent/consultation" class="form-stack">
					<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
					<h3>Jadwalkan Konsultasi Karir BMW Bersama Guru BK &amp; Kaprog</h3>
					<div class="form-row">
						<label class="field">
							<span class="field-label">Jalur Karir yang Ingin Dikonsultasikan</span>
							<select class="input" name="chosen_path">
								<option value="BEKERJA">Bekerja di Mitra Industri (BKK)</option>
								<option value="MELANJUTKAN">Melanjutkan Pendidikan Tinggi Vokasi</option>
								<option value="WIRAUSAHA">Wirausaha Mandiri Terpadu</option>
							</select>
						</label>
						<label class="field">
							<span class="field-label">Pertanyaan / Harapan Orang Tua</span>
							<input class="input" type="text" name="topic_note" placeholder="Mis. Persiapan magang dan peluang kerja di PT Telkom Akses..." required/>
						</label>
					</div>
					<button type="submit" class="button button-primary">Kirim Permohonan Jadwal Konsultasi</button>
				</form>

				<div class="table-wrap">
					<table class="data-table">
						<thead>
							<tr>
								<th>Tanggal</th>
								<th>Jalur Pilihan</th>
								<th>Topik Konsultasi</th>
								<th>Status Jadwal BK</th>
							</tr>
						</thead>
						<tbody>
							for _, c := range data.Consultations {
								<tr>
									<td class="mono">{ c.CreatedAt }</td>
									<td><span class="badge badge-teal">{ c.ChosenPath }</span></td>
									<td>{ c.TopicNote }</td>
									<td><span class="badge badge-gold">{ c.Status }</span></td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		} else if data.Tab == "services" {
			<div class="grid-2">
				<section class="card form-stack">
					<span class="eyebrow">Izin Kehadiran Resmi</span>
					<h2>Pengajuan Surat Izin / Sakit Resmi Ananda ({ data.Student.FullName })</h2>
					<p class="muted">Langsung terhubung ke daftar presensi Guru di kelas dan melindungi poin sikap ananda.</p>
					<form method="post" action="/parent/leave" class="form-stack">
						<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
						<div class="form-row">
							<label class="field">
								<span class="field-label">Jenis Keterangan</span>
								<select class="input" name="leave_type">
									<option value="SAKIT">Sakit (Istirahat / Berobat)</option>
									<option value="IZIN">Izin Keperluan Keluarga</option>
								</select>
							</label>
							<label class="field">
								<span class="field-label">Tanggal</span>
								<input class="input input-mono" type="date" name="leave_date" value="2026-10-25" required/>
							</label>
						</div>
						<label class="field">
							<span class="field-label">Keterangan Orang Tua / Wali</span>
							<input class="input" type="text" name="leave_note" placeholder="Demam sejak semalam, surat dokter menyusul..." required/>
						</label>
						<button type="submit" class="button button-primary">Kirim Surat Izin Resmi ke Sekolah</button>
					</form>
				</section>

				<section class="card form-stack">
					<span class="eyebrow">Layanan Pembayaran SPP &amp; Virtual Account</span>
					<h3>Daftar Tagihan SPP Bulanan &amp; Kwitansi QR Resmi</h3>
					for _, inv := range data.Invoices {
						<div class="info-strip">
							<div class="stat-card-head">
								<strong>SPP { inv.Period } ({ inv.Number })</strong>
								<span class={ "badge " + statusBadgeClass(inv.Status) }>{ inv.StatusLabel }</span>
							</div>
							<span class="mono">Tagihan Akhir: { ui.FormatRupiah(inv.FinalAmount) } · Sisa: { ui.FormatRupiah(inv.Remaining) }</span>
							<span class="muted">VA { inv.Provider }: <strong class="mono">{ inv.VANumber }</strong></span>
							if !inv.IsPaid && data.Shell.DemoMode {
								<form method="post" action="/parent/invoice/pay">
									<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
									<input type="hidden" name="invoice_id" value={ inv.ID }/>
									<button type="submit" class="button button-secondary button-small">Simulasi Lunasi VA</button>
								</form>
							}
						</div>
					}

					<h4>Kwitansi Digital Ber-QR Code Resmi</h4>
					for _, item := range data.Ledger {
						<div class="info-strip">
							<div class="stat-card-head">
								<strong class="mono">{ item.ReceiptNumber }</strong>
								<strong class="mono">{ ui.FormatRupiah(item.AmountDelta) }</strong>
							</div>
							<span class="muted">{ item.TxType } · { ui.FormatDateID(item.CreatedAt) }</span>
							<a class="text-link" href={ "/verify?q=" + item.ReceiptNumber }>Verifikasi Keaslian HMAC Kwitansi</a>
						</div>
					}
				</section>
			</div>
		}
	</div>
}

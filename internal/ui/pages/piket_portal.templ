package pages

import (
	"wesmk/internal/ui"
)

templ PiketPortal(data ui.PiketPortalPage) {
	<div class="page-stack">
		<section class="card form-stack">
			<div class="stat-card-head">
				<div>
					<span class="eyebrow">Posko Guru Piket &amp; Pengendalian Operasional (PIKET-01)</span>
					<h2>Radar Detektor Kelas Kosong, Penugasan Inval &amp; Log Gerbang</h2>
				</div>
				<span class="badge badge-teal">Radar Detektor Aktif</span>
			</div>

			<div class="grid-4">
				for _, cls := range data.Classrooms {
					<article class="card stat-card">
						<div class="stat-card-head">
							<strong>{ cls.Name }</strong>
							if cls.Status == "RED_EMPTY" {
								<span class="badge badge-danger">KELAS KOSONG</span>
							} else {
								<span class="badge badge-success">TERISI PENUH</span>
							}
						</div>
						<p class="stat-title">{ cls.Subject }</p>
						<p class="stat-note">Pengampu: { cls.Teacher }</p>
						<p class="muted">{ cls.Note }</p>
					</article>
				}
			</div>

			<form method="post" action="/piket/assign-inval" class="info-strip form-stack">
				<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
				<h3>Tugaskan Guru Inval Pengganti (+5 Poin Kredit Kinerja Teacher Impact)</h3>
				<div class="form-row">
					<label class="field">
						<span class="field-label">Pilih Ruang Kelas</span>
						<select class="input" name="classroom_id">
							for _, cls := range data.Classrooms {
								<option value={ cls.ID }>{ cls.Name } — { cls.Subject } ({ cls.Status })</option>
							}
						</select>
					</label>
					<label class="field">
						<span class="field-label">Pilih Guru Inval Pengganti</span>
						<select class="input" name="teacher_name">
							for _, t := range data.Teachers {
								<option value={ t.TeacherName }>{ t.TeacherName } ({ t.Subject })</option>
							}
						</select>
					</label>
					<label class="field">
						<span class="field-label">Instruksi / Modul Titipan</span>
						<input class="input" type="text" name="task_note" value="Materi Titipan Guru Asli (Modul Praktik 04)" required/>
					</label>
				</div>
				<button type="submit" class="button button-primary">Tugaskan Guru Inval &amp; Tambah +5 Poin Kinerja</button>
			</form>
		</section>

		<section class="card form-stack">
			<span class="eyebrow">Kendali Akses Gerbang Sekolah</span>
			<h3>Pencatatan Keterlambatan Gerbang &amp; Surat Izin Keluar Lingkungan Sekolah</h3>
			<form method="post" action="/piket/gate-log" class="form-stack">
				<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
				<div class="form-row">
					<label class="field">
						<span class="field-label">NISN Siswa</span>
						<input class="input input-mono" type="text" name="nisn" value="0058471292" required/>
					</label>
					<label class="field">
						<span class="field-label">Nama Siswa &amp; Kelas</span>
						<input class="input" type="text" name="student_name" value="Deni Kurniawan (XII TKJ 1)" required/>
					</label>
					<label class="field">
						<span class="field-label">Jenis Pencatatan</span>
						<select class="input" name="log_type">
							<option value="IZIN_KELUAR_SEMENTARA">Surat Izin Keluar Sementara (QR Pass)</option>
							<option value="TERLAMBAT_MASUK">Terlambat Masuk Gerbang (&gt;15 Menit · Auto PASAL-02)</option>
						</select>
					</label>
				</div>
				<label class="field">
					<span class="field-label">Alasan / Keperluan</span>
					<input class="input" type="text" name="reason" value="Membeli Konektor RJ45 &amp; Kabel Patch-Cord di Koperasi" required/>
				</label>
				<button type="submit" class="button button-secondary">Catat Log Gerbang &amp; Terbitkan QR Pass</button>
			</form>

			<div class="table-wrap">
				<table class="data-table">
					<thead>
						<tr>
							<th>Waktu</th>
							<th>NISN</th>
							<th>Nama Siswa</th>
							<th>Jenis Log</th>
							<th>Keterangan</th>
							<th>Kode QR Pass</th>
						</tr>
					</thead>
					<tbody>
						for _, g := range data.GateLogs {
							<tr>
								<td class="mono">{ g.RecordedAt }</td>
								<td class="mono">{ g.NISN }</td>
								<td><strong>{ g.StudentName }</strong></td>
								<td><span class="badge badge-warning">{ g.LogType }</span></td>
								<td>{ g.Reason }</td>
								<td class="mono">{ g.QrPassHash }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
	</div>
}

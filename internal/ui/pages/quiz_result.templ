package pages

import (
	"strconv"

	"wesmk/internal/ui"
	"wesmk/internal/ui/components"
)

templ QuizResult(result ui.QuizResultView) {
	<div class="quiz-result">
		<div class="quiz-result-mark">@components.Icon("check", "icon")</div>
		<span class="eyebrow">Kuis selesai</span>
		<h3>Jawaban Anda sudah dinilai di server.</h3>
		<p class="quiz-result-score mono">{ strconv.Itoa(result.Score) }<span>/100</span></p>
		<p class="quiz-result-note">
			{ strconv.Itoa(result.Correct) } benar dari { strconv.Itoa(result.Total) } soal.
			if result.Already {
				Jawaban ini sudah pernah dikirim, jadi skor pertama yang dipakai.
			}
		</p>
		<button type="button" class="button button-primary" data-modal-close>Tutup dan kembali</button>
	</div>
}

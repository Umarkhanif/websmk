package pages

import (
	"fmt"
	"strconv"

	"wesmk/internal/ui"
	"wesmk/internal/ui/components"
)

templ HeadmasterPortal(data ui.HeadmasterPortalPage) {
	<div class="page-stack">
		<section class="identity-card">
			<div class="identity-main">
				<span class="avatar avatar-lg">{ data.Shell.Initials }</span>
				<div class="identity-copy">
					<span class="eyebrow">Pusat Kendali Eksekutif</span>
					<h2>Kepemimpinan Berbasis Kinerja Sekolah</h2>
					<p class="muted">{ data.Shell.FullName } · Evaluasi kinerja dan strategi mutu sekolah.</p>
				</div>
			</div>
			<form method="post" action="/headmaster/esign">
				<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
				<button type="submit" class="button button-primary">Tanda Tangani Laporan (E-Sign)</button>
			</form>
			if data.LastSignatureHash != "" {
				<p class="muted mono" style="font-size:0.78rem;">Terakhir: { data.LastSignatureType } · { data.LastSignatureAt } · hash { data.LastSignatureHash }</p>
			} else {
				<p class="muted" style="font-size:0.78rem;">Belum ada laporan yang ditandatangani.</p>
			}
		</section>

		<div class="dashboard-grid">
			<article class="card stat-card">
				<span class="eyebrow">Indeks Transformasi Kesiswaan</span>
				<p class="stat-value mono">{ data.TransformationScore }/100</p>
				<p class="stat-note">Tren Karakter: <strong>{ data.TransformationTrend }</strong></p>
			</article>
			<article class="card stat-card">
				<div class="stat-card-head">
					<span class="eyebrow">Otorisasi Kas</span>
					@components.InfoBubble("Kode OTP hanya dibuka saat akan diberikan kepada bendahara.")
				</div>
				if data.ActiveOTP != "" {
					<p class="stat-title">OTP siap digunakan</p>
					<p class="stat-note">Masa aktif singkat. Buka bagian Otorisasi Kas untuk melihat kode.</p>
				} else {
					<p class="stat-title">Tidak ada OTP aktif</p>
					<p class="stat-note">Terbitkan OTP dari permintaan pembalik jika diperlukan.</p>
				}
			</article>
			<article class="card stat-card">
				<span class="eyebrow">Pendidik Terkalibrasi</span>
				<p class="stat-value mono">{ strconv.Itoa(len(data.Teachers)) } Guru</p>
				<p class="stat-note">Evaluasi pembelajaran terpadu</p>
			</article>
		</div>

		<section class="card form-stack">
			<div class="stat-card-head">
				<div>
					<span class="eyebrow">Evaluasi Dampak Pengajaran</span>
					<h3>Peringkat Kinerja Guru</h3>
				</div>
				@components.InfoBubble("Dihitung terpadu dari pertumbuhan nilai CBT siswa, kejelasan materi, dan validasi kelas.")
			</div>
			<div class="table-wrap">
				<table class="data-table">
					<thead>
						<tr>
							<th>Nama Pendidik</th>
							<th>Mata Pelajaran</th>
							<th>Pertumbuhan Nilai</th>
							<th>Kejelasan Materi</th>
							<th>Validasi Kelas</th>
							<th>Bonus Inval</th>
							<th>Skor Akhir</th>
						</tr>
					</thead>
					<tbody>
						for _, t := range data.Teachers {
							<tr>
								<td><strong>{ t.TeacherName }</strong><br/><span class="muted mono">NIP { t.NIP }</span></td>
								<td>{ t.Subject }</td>
								<td class="mono">{ fmt.Sprintf("%.0f%%", t.CalibratedScoreGrowth) }</td>
								<td class="mono">{ fmt.Sprintf("%.0f%%", t.LowConfusionRate) }</td>
								<td class="mono">{ fmt.Sprintf("%.0f%%", t.LeaderValidationRate) }</td>
								<td class="mono">+{ fmt.Sprintf("%.0f", t.SubstituteBonusPoints) }</td>
								<td class="mono"><span class="badge badge-teal">{ fmt.Sprintf("%.1f / 100", t.FinalImpactScore) }</span></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>

		<div class="grid-2">
			<section class="card form-stack">
				<div class="stat-card-head">
					<div>
						<span class="eyebrow">Otorisasi Kas</span>
						<h3>Persetujuan Jurnal Pembalik</h3>
					</div>
					@components.InfoBubble("Berikan kode hanya kepada bendahara setelah bukti kesalahan diverifikasi.")
				</div>
				if data.ActiveOTP != "" {
					<details class="info-strip">
						<summary>Lihat kode OTP aktif</summary>
						<p class="stat-value mono">{ data.ActiveOTP }</p>
						<p class="muted">Jangan bagikan kode ini melalui grup atau kanal publik.</p>
					</details>
				}
				for _, req := range data.ReversalRequests {
					<div class="info-strip">
						<div class="stat-card-head">
							<strong>Ledger #{ strconv.FormatInt(req.LedgerID, 10) } · Kasir: { req.CashierName }</strong>
							<span class="badge badge-gold">{ req.Status }</span>
						</div>
						<span>Nominal: <strong class="mono">{ ui.FormatRupiah(req.AmountOriginal) }</strong> &rarr; Koreksi: <strong class="mono">{ ui.FormatRupiah(req.AmountCorrected) }</strong></span>
						<span class="muted">Alasan: { req.Reason }</span>
						<form method="post" action="/headmaster/otp">
							<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
							<input type="hidden" name="req_id" value={ req.ID }/>
							<button type="submit" class="button button-secondary button-small">Terbitkan OTP Baru</button>
						</form>
					</div>
				}
			</section>

			<section class="card form-stack">
				<div class="stat-card-head">
					<div>
						<span class="eyebrow">Asisten Strategis Eksekutif</span>
						<h3>Analisis Mutu &amp; Kebijakan Sekolah</h3>
					</div>
					@components.InfoBubble("Rekomendasi langkah peningkatan mutu sekolah berbasis model analitik pembelajaran SMK.")
				</div>
				<form method="post" action="/headmaster/ai-advisor" class="form-stack">
					<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
					<div class="field">
						<div class="field-head">
							<label class="field-label">Topik / Pertanyaan Evaluasi</label>
						</div>
						<textarea class="input" name="query" required>Bagaimana rekomendasi langkah untuk meningkatkan ketercapaian sertifikasi BNSP pada siswa yang hasil evaluasi CBT menunjukkan kelemahan di topik DHCP troubleshooting?</textarea>
					</div>
					<button type="submit" class="button button-primary">Analisis Sekarang</button>
				</form>
				if data.AiAdvice != "" {
					<div class="info-strip">
						<span class="info-strip-label">Rekomendasi Kebijakan</span>
						<p>{ data.AiAdvice }</p>
					</div>
				}
			</section>
		</div>
	</div>
}

package pages

import (
	"strconv"

	"wesmk/internal/ui"
	"wesmk/internal/ui/components"
)

templ DisciplinePortal(data ui.DisciplinePortalPage) {
	<div class="page-stack">
		if data.Tab == "violations" {
			<section class="card form-stack">
				<div class="stat-card-head">
					<div>
						<span class="eyebrow">Kesiswaan &amp; BK</span>
						<h2>Pencatatan &amp; Pemantauan Tata Tertib</h2>
					</div>
					@components.InfoBubble("Pencatatan pelanggaran siswa terhubung langsung dengan riwayat karakter dan surat dinas.")
				</div>
				<form method="post" action="/discipline/violation/add" class="form-row">
					<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
					<div class="field">
						<div class="field-head">
							<label class="field-label">Nama Siswa &amp; Kelas</label>
						</div>
						<input class="input" type="text" name="student_name" placeholder="Nama Siswa (Kelas)..." required/>
					</div>
					<div class="field">
						<div class="field-head">
							<label class="field-label">Pasal Tata Tertib</label>
							@components.InfoBubble("Kode pasal buku pedoman kedisiplinan (contoh: PASAL-08).")
						</div>
						<input class="input input-mono" type="text" name="article_code" value="PASAL-08" required/>
					</div>
					<div class="field">
						<div class="field-head">
							<label class="field-label">Uraian Pelanggaran</label>
						</div>
						<input class="input" type="text" name="article_title" placeholder="Mis. Tidak memakai APD sepatu bengkel..." required/>
					</div>
					<div class="field">
						<div class="field-head">
							<label class="field-label">Poin Pengurang</label>
							@components.InfoBubble("Poin pengurang kedisiplinan (skala 1 - 100).")
						</div>
						<input class="input input-mono" type="number" name="points" value="10" min="1" max="100" required/>
					</div>
					<div class="field">
						<div class="field-head">
							<label class="field-label">Simpan</label>
						</div>
						<button type="submit" class="button button-primary">Catat Pelanggaran</button>
					</div>
				</form>

				<div class="table-wrap">
					<table class="data-table">
						<thead>
							<tr>
								<th>Siswa</th>
								<th>Pasal &amp; Uraian</th>
								<th>Sumber</th>
								<th>Poin</th>
								<th>Status &amp; Surat Panggilan</th>
								<th>Aksi</th>
							</tr>
						</thead>
						<tbody>
							for _, v := range data.Violations {
								<tr>
									<td><strong>{ v.StudentName }</strong></td>
									<td><span class="mono">{ v.ArticleCode }</span> — { v.ArticleTitle }</td>
									<td><span class="badge badge-neutral">{ v.SourceType }</span></td>
									<td class="mono">-{ strconv.Itoa(v.PointsDeducted) }</td>
									<td>
										<span class="badge badge-warning">{ v.Status }</span>
										if v.SummonLetterHash != "" {
											<br/><a class="mono" href={ "/verify?q=" + v.SummonLetterHash }>Cek HMAC Surat</a>
										}
									</td>
									<td>
										<form method="post" action="/discipline/violation/summon">
											<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
											<input type="hidden" name="violation_id" value={ v.ID }/>
											<button type="submit" class="button button-secondary button-small">Terbitkan Surat Panggilan</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>

			<div class="grid-2">
				<section class="card form-stack">
					<div class="stat-card-head">
						<div>
							<span class="eyebrow">Laporan Kasus</span>
							<h3>Laporan Perundungan Terverifikasi</h3>
						</div>
						@components.InfoBubble("Laporan perlindungan siswa diverifikasi otomatis dari beberapa klaster pelapor independen.")
					</div>
					for _, pr := range data.PeerReports {
						<div class="info-strip">
							<div class="stat-card-head">
								<strong>{ pr.TargetStudentName } ({ pr.Location })</strong>
								<span class="badge badge-danger">{ pr.Status }</span>
							</div>
							<span><strong>{ pr.ArticleCategory }</strong>: { pr.Description }</span>
							<span class="muted mono">Klaster: { pr.ReporterClusterHash } · { strconv.Itoa(pr.DistinctClusterCount) } Pelapor</span>
							<form method="post" action="/discipline/peer-report/resolve" class="leader-actions">
								<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
								<input type="hidden" name="report_id" value={ pr.ID }/>
								<button type="submit" name="status" value="INVESTIGATING_BK" class="button button-secondary button-small">Investigasi BK</button>
								<button type="submit" name="status" value="RESOLVED" class="button button-primary button-small">Tandai Selesai</button>
							</form>
						</div>
					}
				</section>

				<section class="card form-stack">
					<div class="stat-card-head">
						<div>
							<span class="eyebrow">Konseling Siswa &amp; Karier</span>
							<h3>Permintaan Konsultasi Orang Tua</h3>
						</div>
						@components.InfoBubble("Permintaan bimbingan langsung dari orang tua terkait pilihan karier BMW (Bekerja, Melanjutkan, Wirausaha).")
					</div>
					for _, c := range data.Consultations {
						<div class="info-strip">
							<div class="stat-card-head">
								<strong>{ c.StudentName } ({ c.ParentName })</strong>
								<span class="badge badge-gold">{ c.Status }</span>
							</div>
							<span>Jalur: <strong>{ c.ChosenPath }</strong> — { c.TopicNote }</span>
							<form method="post" action="/discipline/consultation/schedule">
								<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
								<input type="hidden" name="consult_id" value={ c.ID }/>
								<button type="submit" class="button button-primary button-small">Jadwalkan Sesi BK</button>
							</form>
						</div>
					}
				</section>
			</div>
		} else if data.Tab == "transformation-index" {
			<div class="dashboard-grid">
				<article class="card stat-card">
					<span class="eyebrow">Indeks Transformasi Sikap</span>
					<p class="stat-value mono">{ data.TransformationScore }/100</p>
					<p class="stat-note">Tren Pemulihan: <strong>{ data.TransformationTrend }</strong></p>
				</article>
				<article class="card stat-card">
					<span class="eyebrow">Siswa Sembuh / Pulih Total</span>
					<p class="stat-value mono">{ strconv.Itoa(data.RecoveredCount) } Siswa</p>
					<p class="stat-note">Disiplin kembali positif selama 30–60 hari</p>
				</article>
				<article class="card stat-card">
					<span class="eyebrow">Dalam Pemantauan Aktif</span>
					<p class="stat-value mono">{ strconv.Itoa(data.ActiveCount) } Siswa</p>
					<p class="stat-note">Pendampingan harian oleh Guru BK</p>
				</article>
			</div>

			<section class="card form-stack">
				<span class="eyebrow">Evaluasi Pemulihan Karakter</span>
				<h3>Daftar Pembinaan Siswa Aktif</h3>
				for _, cs := range data.CounselingSessions {
					<div class="info-strip form-stack">
						<div class="stat-card-head">
							<strong>{ cs.StudentName } — { cs.IssueSummary }</strong>
							<span class="badge badge-teal">{ cs.RecoveryStatus } ({ strconv.Itoa(cs.DailyCheckinsCompleted) } Hari)</span>
						</div>
						<p class="muted">Periode: <span class="mono">{ cs.StartDate } s.d. { cs.EndDate }</span> · Konselor: { cs.CounselorName }</p>
						<p>{ cs.Notes }</p>
						<form method="post" action="/discipline/counseling/update" class="form-row">
							<input type="hidden" name="_csrf" value={ data.Shell.CSRFToken }/>
							<input type="hidden" name="session_id" value={ cs.ID }/>
							<input class="input" type="text" name="notes" value={ cs.Notes } required/>
							<select class="input" name="status">
								<option value="MONITORING">MONITORING (Lanjut Pembinaan)</option>
								<option value="RECOVERED_SUCCESS">RECOVERED_SUCCESS (Pulih Total)</option>
							</select>
							<button type="submit" class="button button-primary button-small">Perbarui Pembinaan</button>
						</form>
					</div>
				}
			</section>
		}
	</div>
}

package layout

import (
	"wesmk/internal/ui"
	"wesmk/internal/ui/components"
)

templ Base(shell ui.RoleShell, content templ.Component) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="color-scheme" content="light"/>
			<meta name="theme-color" content="#0B1730"/>
			<title>{ shell.PageTitle } — WESMK</title>
			<meta name="description" content="Portal layanan sekolah WESMK: akademik, keuangan, PKL, dan komunikasi sekolah dalam satu tempat."/>
			<link rel="icon" type="image/svg+xml" href="/ui-assets/favicon.svg"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/ui-assets/app.css?v=20261030b"/>
			<script src="/ui-assets/htmx.min.js" defer></script>
			<script src="/ui-assets/alpine.min.js" defer></script>
			<script src="/ui-assets/app.js?v=20261030a" defer></script>
		</head>
		<body class="app-body" hx-headers={ `{"X-CSRF-Token":"` + shell.CSRFToken + `"}` }>
			<a class="skip-link" href="#main-content">Lewati ke konten utama</a>
			<div class="app-shell">
				@components.Sidebar(shell)
				<div class="app-main">
					@components.Topbar(shell)
					<main id="main-content" class="page" tabindex="-1">
						if shell.Flash != "" {
							@components.Flash(shell.Flash, shell.FlashKind)
						}
						@content
					</main>
				</div>
			</div>
			@components.MobileNav(shell)
			<div id="toast-region" class="toast-region" aria-live="polite" aria-atomic="true"></div>
		</body>
	</html>
}

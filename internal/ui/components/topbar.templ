package components

import "wesmk/internal/ui"

templ Topbar(shell ui.RoleShell) {
	<header class="topbar">
		<button class="icon-button mobile-only" type="button" data-drawer-toggle aria-controls="mobile-drawer" aria-expanded="false" aria-label="Buka menu navigasi">
			@Icon("menu", "icon")
		</button>

		<div class="topbar-heading">
			<span class="eyebrow">{ shell.AcademicYear } · { shell.RoleLabel }</span>
			<h1>{ shell.PageTitle }</h1>
		</div>

		<div class="topbar-actions">
			<span class="session-note">
				@Icon("lock", "icon icon-xs")
				<span>Sesi aman</span>
			</span>
			if shell.DemoMode {
				<details class="user-menu">
					<summary aria-label="Ganti peran pengguna demo">
						@Icon("users", "icon icon-xs")
						<span class="user-menu-copy">
							<strong>Ganti Peran</strong>
							<span>{ shell.RoleLabel }</span>
						</span>
						@Icon("chevron-down", "icon icon-xs")
					</summary>
					<div class="user-menu-panel">
						<div class="user-menu-meta">
							<div>
								<strong>Pilih Peran Demo</strong>
								<span>8 akses portal sekolah</span>
							</div>
						</div>
						<div class="user-menu-divider"></div>
						<form method="post" action="/demo/role" class="menu-form">
							<input type="hidden" name="_csrf" value={ shell.CSRFToken }/>
							<button type="submit" name="role" value="student" class="menu-button"><span>1. Murid &amp; Ketua Kelas</span></button>
							<button type="submit" name="role" value="parent" class="menu-button"><span>2. Orang Tua / Wali</span></button>
							<button type="submit" name="role" value="treasurer" class="menu-button"><span>3. Bendahara / Keuangan</span></button>
							<button type="submit" name="role" value="teacher" class="menu-button"><span>4. Guru / Pengawas / Wali</span></button>
							<button type="submit" name="role" value="discipline" class="menu-button"><span>5. Kesiswaan &amp; BK</span></button>
							<button type="submit" name="role" value="piket" class="menu-button"><span>6. Guru Piket</span></button>
							<button type="submit" name="role" value="admin_tu" class="menu-button"><span>7. Admin TU &amp; Dapodik</span></button>
							<button type="submit" name="role" value="headmaster" class="menu-button"><span>8. Kepala Sekolah</span></button>
						</form>
					</div>
				</details>

				<details class="user-menu">
					<summary aria-label="Skenario demo">
						@Icon("sparkles", "icon icon-xs")
						<span class="user-menu-copy">
							<strong>Skenario Demo</strong>
							<span>3 alur utama</span>
						</span>
						@Icon("chevron-down", "icon icon-xs")
					</summary>
					<div class="user-menu-panel">
						<form method="post" action="/demo/scenario" class="menu-form">
							<input type="hidden" name="_csrf" value={ shell.CSRFToken }/>
							<button type="submit" name="scenario" value="1" class="menu-button">
								<span>Demo 1: Gatekeeper SPP &amp; Dispensasi 7H</span>
							</button>
							<button type="submit" name="scenario" value="2" class="menu-button">
								<span>Demo 2: CBT Anti-Curang &amp; Bekal Ilmu</span>
							</button>
							<button type="submit" name="scenario" value="3" class="menu-button">
								<span>Demo 3: Catatan Wali &amp; Pantau Ortu</span>
							</button>
						</form>
					</div>
				</details>
			}
			<a class="topbar-link" href="/verify">Verifikasi publik</a>

			<details class="user-menu">
				<summary aria-label="Buka menu akun">
					<span class="avatar avatar-sm" aria-hidden="true">{ shell.Initials }</span>
					<span class="user-menu-copy">
						<strong>{ shell.FullName }</strong>
						<span>{ shell.RoleLabel }</span>
					</span>
					@Icon("chevron-down", "icon icon-xs")
				</summary>
				<div class="user-menu-panel">
					<div class="user-menu-meta">
						<span class="avatar" aria-hidden="true">{ shell.Initials }</span>
						<div>
							<strong>{ shell.FullName }</strong>
							<span>{ shell.Username }</span>
						</div>
					</div>
					<div class="user-menu-divider"></div>
					if shell.Role == "admin_tu" || shell.Role == "headmaster" {
						<form method="post" action="/state/reset" class="menu-form">
							<input type="hidden" name="_csrf" value={ shell.CSRFToken }/>
							<button type="submit" class="menu-button">
								@Icon("sliders", "icon")
								<span>Reset data ke awal demo</span>
							</button>
						</form>
					}
					<form method="post" action="/logout" class="menu-form">
						<input type="hidden" name="_csrf" value={ shell.CSRFToken }/>
						<button type="submit" class="menu-button">
							@Icon("logout", "icon")
							<span>Keluar dari portal</span>
						</button>
					</form>
				</div>
			</details>
		</div>
	</header>
}

package components

import "wesmk/internal/ui"

templ Topbar(shell ui.RoleShell) {
	<header class="topbar">
		<button class="icon-button mobile-only" type="button" data-drawer-toggle aria-controls="mobile-drawer" aria-expanded="false" aria-label="Buka menu navigasi">
			@Icon("menu", "icon")
		</button>

		<div class="topbar-heading">
			<span class="eyebrow">{ shell.AcademicYear } · { shell.RoleLabel }</span>
			<h1>{ shell.PageTitle }</h1>
		</div>

		<div class="topbar-actions">
			<span class="connection-chip" data-connection-status role="status" aria-live="polite" title="Koneksi internet terputus" hidden>
				<span class="connection-dot" aria-hidden="true"></span>
				<span class="connection-text">Offline</span>
			</span>
			<span class="session-note">
				@Icon("lock", "icon icon-xs")
				<span>Sesi aman</span>
			</span>
			<a class="topbar-link" href="/verify">Verifikasi publik</a>
			<a class="topbar-link" href="/contact">Lapor Bug / Kontak</a>

			<details class="user-menu topbar-account-menu">
				<summary aria-label="Buka menu akun">
					<span class="avatar avatar-sm" aria-hidden="true">{ shell.Initials }</span>
					<span class="user-menu-copy">
						<strong>{ shell.FullName }</strong>
						<span>{ shell.RoleLabel }</span>
					</span>
					@Icon("chevron-down", "icon icon-xs")
				</summary>
				<div class="user-menu-panel">
					<div class="user-menu-meta">
						<span class="avatar" aria-hidden="true">{ shell.Initials }</span>
						<div>
							<strong>{ shell.FullName }</strong>
							<span>{ shell.Username }</span>
						</div>
					</div>
					<div class="user-menu-divider"></div>
					if shell.Role == "admin_tu" || shell.Role == "treasurer" || shell.Role == "headmaster" || shell.Role == "developer" {
						<a class="menu-button" href="/security">
							@Icon("lock", "icon")
							<span>Keamanan Akun &amp; MFA</span>
						</a>
					}
					if shell.Role == "admin_tu" || shell.Role == "headmaster" {
						<form method="post" action="/state/reset" class="menu-form">
							<input type="hidden" name="_csrf" value={ shell.CSRFToken }/>
							<button type="submit" class="menu-button">
								@Icon("sliders", "icon")
								<span>Reset data ke awal demo</span>
							</button>
						</form>
					}
					<form method="post" action="/logout" class="menu-form">
						<input type="hidden" name="_csrf" value={ shell.CSRFToken }/>
						<button type="submit" class="menu-button">
							@Icon("logout", "icon")
							<span>Keluar dari portal</span>
						</button>
					</form>
				</div>
			</details>
		</div>
	</header>
}

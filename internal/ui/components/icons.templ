package components

// Icon renders a small, consistent line icon set. The paths follow the visual
// language of Lucide so the migration keeps the same affordances without
// pulling an icon font or a client-side library into the page.
templ Icon(name string, class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		if name == "dashboard" {
			<rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
			<rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
			<rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
			<rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
		} else if name == "book" {
			<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
			<path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
		} else if name == "file-check" {
			<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
			<path d="M14 2v6h6"></path>
			<path d="m9 15 2 2 4-4"></path>
		} else if name == "monitor" {
			<rect x="2" y="3" width="20" height="14" rx="2"></rect>
			<path d="M8 21h8"></path>
			<path d="M12 17v4"></path>
			<path d="m9 10 2 2 4-4"></path>
		} else if name == "file-text" {
			<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
			<path d="M14 2v6h6"></path>
			<path d="M8 13h8"></path>
			<path d="M8 17h6"></path>
		} else if name == "award" {
			<circle cx="12" cy="8" r="6"></circle>
			<path d="M8.2 13.1 7 22l5-3 5 3-1.2-8.9"></path>
		} else if name == "sparkles" {
			<path d="m12 3 1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6z"></path>
			<path d="m19 15 .8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"></path>
			<path d="m5 15 .6 1.4L7 17l-1.4.6L5 19l-.6-1.4L3 17l1.4-.6z"></path>
		} else if name == "heart" {
			<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8z"></path>
		} else if name == "trending" {
			<path d="m3 17 6-6 4 4 8-8"></path>
			<path d="M15 7h6v6"></path>
		} else if name == "compass" {
			<circle cx="12" cy="12" r="9"></circle>
			<path d="m16 8-2.4 5.6L8 16l2.4-5.6z"></path>
		} else if name == "wallet" {
			<path d="M20 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0 0 4h15a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5"></path>
			<path d="M16 13h.01"></path>
		} else if name == "receipt" {
			<path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1z"></path>
			<path d="M8 7h8"></path>
			<path d="M8 11h8"></path>
			<path d="M8 15h5"></path>
		} else if name == "shield-alert" {
			<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
			<path d="M12 8v4"></path>
			<path d="M12 16h.01"></path>
		} else if name == "calendar" {
			<rect x="3" y="4" width="18" height="18" rx="2"></rect>
			<path d="M16 2v4"></path>
			<path d="M8 2v4"></path>
			<path d="M3 10h18"></path>
		} else if name == "help" {
			<circle cx="12" cy="12" r="9"></circle>
			<path d="M9.1 9a3 3 0 1 1 5.8 1c0 2-3 2-3 4"></path>
			<path d="M12 17h.01"></path>
		} else if name == "users" {
			<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
			<circle cx="9" cy="7" r="4"></circle>
			<path d="M22 21v-2a4 4 0 0 0-3-3.9"></path>
			<path d="M16 3.1a4 4 0 0 1 0 7.8"></path>
		} else if name == "alert" {
			<path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path>
			<path d="M12 9v4"></path>
			<path d="M12 17h.01"></path>
		} else if name == "flame" {
			<path d="M8.5 14.5A4.5 4.5 0 0 0 13 19a4.5 4.5 0 0 0 4.5-4.5c0-2.5-1.5-4.5-3-6.5-.8-1.1-1.5-2.3-1.5-4-2 1-4 3.5-4 7"></path>
			<path d="M12 22c-4 0-6-2.5-6-6 0-2.5 1.5-4.5 3-6"></path>
		} else if name == "radio" {
			<circle cx="12" cy="12" r="2"></circle>
			<path d="M7.1 16.9a7 7 0 0 1 0-9.8"></path>
			<path d="M16.9 7.1a7 7 0 0 1 0 9.8"></path>
			<path d="M4.2 19.8a11 11 0 0 1 0-15.6"></path>
			<path d="M19.8 4.2a11 11 0 0 1 0 15.6"></path>
		} else if name == "sliders" {
			<path d="M4 21v-7"></path>
			<path d="M4 10V3"></path>
			<path d="M12 21v-9"></path>
			<path d="M12 8V3"></path>
			<path d="M20 21v-5"></path>
			<path d="M20 12V3"></path>
			<path d="M1 14h6"></path>
			<path d="M9 8h6"></path>
			<path d="M17 16h6"></path>
		} else if name == "briefcase" {
			<rect x="2" y="7" width="20" height="14" rx="2"></rect>
			<path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
		} else if name == "graduation" {
			<path d="m2 10 10-5 10 5-10 5z"></path>
			<path d="M6 12v5c3 2 9 2 12 0v-5"></path>
			<path d="M22 10v6"></path>
		} else if name == "check" {
			<path d="m20 6-11 11-5-5"></path>
		} else if name == "lock" {
			<rect x="4" y="11" width="16" height="10" rx="2"></rect>
			<path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
		} else if name == "clock" {
			<circle cx="12" cy="12" r="9"></circle>
			<path d="M12 7v5l3 2"></path>
		} else if name == "arrow-right" {
			<path d="M5 12h14"></path>
			<path d="m13 6 6 6-6 6"></path>
		} else if name == "logout" {
			<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
			<path d="m16 17 5-5-5-5"></path>
			<path d="M21 12H9"></path>
		} else if name == "menu" {
			<path d="M4 6h16"></path>
			<path d="M4 12h16"></path>
			<path d="M4 18h16"></path>
		} else if name == "x" {
			<path d="m6 6 12 12"></path>
			<path d="m18 6-12 12"></path>
		} else if name == "chevron-down" {
			<path d="m6 9 6 6 6-6"></path>
		} else if name == "external" {
			<path d="M15 3h6v6"></path>
			<path d="M10 14 21 3"></path>
			<path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"></path>
		} else if name == "user" {
			<circle cx="12" cy="8" r="4"></circle>
			<path d="M4 21a8 8 0 0 1 16 0"></path>
		} else if name == "mail" {
			<rect x="2" y="4" width="20" height="16" rx="2"></rect>
			<path d="m2 7 10 6 10-6"></path>
		} else if name == "phone" {
			<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"></path>
		} else {
			<circle cx="12" cy="12" r="9"></circle>
			<path d="M12 8v4"></path>
			<path d="M12 16h.01"></path>
		}
	</svg>
}

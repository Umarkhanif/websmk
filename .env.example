# --- Runtime --------------------------------------------------------------
# development | production. Production disables demo accounts by default.
WESMK_ENV="development"
PORT="3000"

# Postgres 16 and Redis 7 (docker compose up -d starts both locally).
DATABASE_URL="postgres://wesmk:wesmk@localhost:5432/wesmk?sslmode=disable"
REDIS_URL="redis://localhost:6379/0"


# Public URL of the deployment. Used for origin checks and secure cookies.
APP_URL="https://wesmk.example.sch.id"

# --- Gemini AI ------------------------------------------------------------
# Required for AI features; the endpoint returns 503 without it.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- Authentication -------------------------------------------------------
# Demo accounts (9 akun contoh) only exist while demo mode is on.
# Default: on when WESMK_ENV != production, off in production.
WESMK_DEMO_MODE="true"

# Shared password for the demo accounts. Change it for public demo links.
WESMK_DEMO_PASSWORD="Wesmk#2026"

# Force the session cookie Secure flag (default: on in production, off elsewhere).
# Set false only for local production-mode testing over plain HTTP.
WESMK_SECURE_COOKIE="false"

# Trust X-Forwarded-For from a reverse proxy (default: production only).
WESMK_TRUST_PROXY="false"

# --- Nilai & pembayaran (server-authoritative) -----------------------------
# HMAC key for ledger/receipt signatures. Wajib di production (minimal 16 karakter);
# tanpa ini kwitansi bisa dipalsukan. Nilai dev dipakai hanya di luar production.
WESMK_RECEIPT_SECRET=""

# Secret bersama untuk POST /api/payments/callback (callback gateway VA).
# Kosong = webhook nonaktif (503), jadi jangan biarkan kosong di production.
# Tanda tangan: HMAC-SHA256("<unix-timestamp>.<raw-body>") di header X-Wesmk-Signature,
# timestamp di header X-Wesmk-Timestamp (ditolak bila > 5 menit).
WESMK_PAYMENT_WEBHOOK_SECRET=""

# Real accounts for non-demo deployments, as a JSON array. Passwords are
# hashed at startup and never returned to the browser. Example:
# WESMK_USERS='[{"identifier":"198509122010012005","password":"GantiSaya#2026","fullName":"Bendahara Sekolah","role":"treasurer"}]'
WESMK_USERS=""

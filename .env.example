# --- Runtime --------------------------------------------------------------
# development | production. Mode demo sudah dihapus; akun dibuat via WESMK_USERS.
WESMK_ENV="development"
PORT="3000"

# Postgres dan Redis. Bisa lokal lewat docker compose, atau hosted tanpa Docker:
#   - Supabase: ambil "Session pooler" URI (port 5432), bukan transaction pooler 6543.
#   - Upstash:  ambil Redis URL berawalan rediss:// (wajib TLS).
DATABASE_URL="postgres://wesmk:wesmk@localhost:5432/wesmk?sslmode=disable"
REDIS_URL="redis://localhost:6379/0"

# --- Akun awal ------------------------------------------------------------
# JSON array yang di-upsert setiap boot. Database baru tidak punya akun sama
# sekali, jadi minimal satu admin_tu wajib ada untuk membuat akun lain lewat UI.
# Hapus variabel ini setelah akun nyata dibuat: password di sini akan menimpa
# password yang sudah diubah lewat halaman Akun & Keamanan.
# WESMK_USERS='[{"identifier":"admin.tu","password":"GantiSaya#2026","fullName":"Admin TU","role":"admin_tu"}]'


# Public URL of the deployment. Used for origin checks and secure cookies.
APP_URL="https://wesmk.example.sch.id"

# --- Gemini AI ------------------------------------------------------------
# Required for AI features; the endpoint returns 503 without it.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- Authentication -------------------------------------------------------
# Akun nyata diatur lewat WESMK_USERS (lihat bagian bawah). Tanpa itu tidak ada
# akun yang bisa login; wajib minimal satu admin_tu untuk onboarding user lain.
# Kunci enkripsi secret TOTP di database (AES-256-GCM). Wajib di production,
# minimal 32 karakter acak. Nilai dev mengikuti WESMK_RECEIPT_SECRET bila kosong.
# Jangan mengganti kunci setelah ada akun MFA tanpa mereset MFA mereka.
WESMK_MFA_KEY=""

# Force the session cookie Secure flag (default: on in production, off elsewhere).
# Set false only for local production-mode testing over plain HTTP.
WESMK_SECURE_COOKIE="false"

# Trust X-Forwarded-For from a reverse proxy (default: off, enable only behind one).
WESMK_TRUST_PROXY="false"

# Read student profile fields from the normalized students table (default: on).
# Missing rows fall back to app_state until the boot backfill has run.
WESMK_DOMAIN_STUDENT_PROFILE="true"

# Read invoices and ledger from the normalized finance tables (default: on).
# Falls back to app_state when the domain rows are empty.
WESMK_DOMAIN_FINANCE="true"

# Read daily attendance from the normalized table (default: on).
WESMK_DOMAIN_ATTENDANCE="true"

# Read the exam question bank and proctor sessions from normalized tables
# (default: on). Answer keys are stripped for student views.
WESMK_DOMAIN_EXAM="true"

# Read PKL placements/logs/journals and BKK postings/applications from
# normalized tables (default: on). Supervisor PINs are stripped in the service.
WESMK_DOMAIN_PKL_BKK="true"

# --- Nilai & pembayaran (server-authoritative) -----------------------------
# HMAC key for ledger/receipt signatures. Wajib di production (minimal 16 karakter);
# tanpa ini kwitansi bisa dipalsukan. Nilai dev dipakai hanya di luar production.
WESMK_RECEIPT_SECRET=""

# Secret bersama untuk POST /api/payments/callback (callback gateway VA).
# Kosong = webhook nonaktif (503), jadi jangan biarkan kosong di production.
# Tanda tangan: HMAC-SHA256("<unix-timestamp>.<raw-body>") di header X-Wesmk-Signature,
# timestamp di header X-Wesmk-Timestamp (ditolak bila > 5 menit).
WESMK_PAYMENT_WEBHOOK_SECRET=""

# Real accounts for non-demo deployments, as a JSON array. Passwords are
# hashed at startup and never returned to the browser. Example:
# WESMK_USERS='[{"identifier":"198509122010012005","password":"GantiSaya#2026","fullName":"Bendahara Sekolah","role":"treasurer"}]'
WESMK_USERS=""

# PIN 6 digit bendahara untuk verifikasi kas tunai (dev default 123456).
WESMK_TREASURER_PIN="123456"

# --- WhatsApp (magic link orang tua) ---------------------------------------
# Webhook menerima JSON {"to","message"}; token dikirim sebagai Bearer.
# Wajib diisi di production: tanpa webhook, permintaan magic link ditolak (503)
# dan tidak hanya dicatat di log.
WESMK_WA_WEBHOOK_URL=""
WESMK_WA_WEBHOOK_TOKEN=""

# --- Mode demo -------------------------------------------------------------
# Nonaktifkan login seluruhnya (semua request memakai user demo). Hanya untuk
# uji coba/lokal; jangan pernah aktif di production (dipaksa off otomatis).
# WESMK_DEMO_NOAUTH="true"
# WESMK_DEMO_ROLE="teacher"
